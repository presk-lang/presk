fn SelfAttention.apply{B T}(θ : params SelfAttention, x : ℝ[batch: B, seq: T, model: 16], mask : bool[seq: T, seq2: T]) -> ℝ[batch: B, seq: T, model: 16] {
  wo : params Linear{16, 16} = θ.wo
  wq : params Linear{16, 16} = θ.wq
  %24 : ℝ[batch: B, seq: T, 16] = call Linear.apply{In = 16, Out = 16}(wq, x)
  q : ℝ[batch: B, heads: 2, seq: T, hd: 8] = split_heads 2x8 %24
  %26 : nat = 8
  %27 : ℝ[] = real %26
  %28 : ℝ[] = sqrt %27
  %29 : ℝ[batch: B, heads: 2, seq: T, hd: 8] = div q, %28
  wk : params Linear{16, 16} = θ.wk
  %31 : ℝ[batch: B, seq: T, 16] = call Linear.apply{In = 16, Out = 16}(wk, x)
  k : ℝ[batch: B, heads: 2, seq: T, hd: 8] = split_heads 2x8 %31
  s : ℝ[batch: B, heads: 2, seq: T, seq2: T] = ein[batch, heads, seq, seq2]([batch, heads, seq, hd] * [batch, heads, seq2, hd]) %29, k
  a : ℝ[batch: B, heads: 2, seq: T, seq2: T] = softmax axis seq2 s, mask
  wv : params Linear{16, 16} = θ.wv
  %36 : ℝ[batch: B, seq: T, 16] = call Linear.apply{In = 16, Out = 16}(wv, x)
  v : ℝ[batch: B, heads: 2, seq: T, hd: 8] = split_heads 2x8 %36
  o : ℝ[batch: B, heads: 2, seq: T, hd: 8] = ein[batch, heads, seq, hd]([batch, heads, seq, seq2] * [batch, heads, seq2, hd]) a, v
  %39 : ℝ[batch: B, seq: T, model: 16] = merge_heads 2x8 o
  %40 : ℝ[batch: B, seq: T, 16] = call Linear.apply{In = 16, Out = 16}(wo, %39)
  return %40
}
