fn mse.bwd{D B}(θ : params MLP{D, 4*D}, x : ℝ[batch: B, model: D], residuals : (ℝ[batch: B, D], ℝ[batch: B, model: D], (ℝ[batch: B, 4*D], ℝ[batch: B, 4*D])), ct : ℝ[]) -> (params MLP{D, 4*D}) {
  %23 : (ℝ[batch: B, 4*D], ℝ[batch: B, 4*D]) = residuals.2
  %24 : ℝ[batch: B, model: D] = mean_vjp ct, x
  %25 : nat = 2
  %26 : ℝ[] = real %25
  %27 : ℝ[batch: B, model: D] = residuals.1
  %28 : ℝ[batch: B, model: D] = mul %26, %27
  %29 : ℝ[batch: B, model: D] = mul %24, %28
  %30 : ℝ[batch: B, D] = residuals.0
  %31 : ℝ[batch: B, D] = sum_to %29, %30
  %32 : (params MLP{D, 4*D}) = call MLP.apply.bwd{D = D, hidden = 4*D}(θ, x, %23, %31)
  %33 : params MLP{D, 4*D} = %32.0
  %34 : (params MLP{D, 4*D}) = (%33)
  return %34
}

fn MLP.apply.bwd{D hidden}(θ : params MLP{D, hidden}, x : ℝ[..., D], residuals : (ℝ[..., hidden], ℝ[..., hidden]), ct : ℝ[..., D]) -> (params MLP{D, hidden}) {
  l1 : params Linear{D, hidden} = θ.l1
  l2 : params Linear{hidden, D} = θ.l2
  %25 : ℝ[..., hidden] = residuals.1
  %26 : (params Linear{hidden, D}, ℝ[..., hidden]) = call Linear.apply.bwd{In = hidden, Out = D}(l2, %25, ct)
  %27 : ℝ[..., hidden] = %26.1
  %28 : ℝ[..., hidden] = residuals.0
  %29 : ℝ[..., hidden] = gelu' %28
  %30 : ℝ[..., hidden] = mul %27, %29
  %31 : (params Linear{D, hidden}, ℝ[..., D]) = call Linear.apply.bwd{In = D, Out = hidden}(l1, x, %30)
  %32 : params Linear{D, hidden} = %31.0
  %33 : params Linear{hidden, D} = %26.0
  %34 : params MLP{D, hidden} = {l1 = %32, l2 = %33}
  %35 : (params MLP{D, hidden}) = (%34)
  return %35
}

fn Linear.apply.bwd{In Out}(θ : params Linear{In, Out}, x : ℝ[..., In], ct : ℝ[..., Out]) -> (params Linear{In, Out}, ℝ[..., In]) {
  %17 : ℝ[In, Out] = dot_vjp_r x, ct
  b : ℝ[Out] = θ.b
  %19 : ℝ[Out] = sum_to ct, b
  %20 : params Linear{In, Out} = {w = %17, b = %19}
  w : ℝ[In, Out] = θ.w
  %22 : ℝ[..., In] = dot_vjp_l ct, w
  %23 : (params Linear{In, Out}, ℝ[..., In]) = (%20, %22)
  return %23
}
