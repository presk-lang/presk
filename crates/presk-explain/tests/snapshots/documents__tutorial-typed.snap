## 9 The kernels and the host

PSK-Kernel is the loop nests the backends run: one kernel per distinct nest, under its type and its layout. The host program launches them, converting a value where a kernel reads it in another type.

```text
-- 11 kernels, 30 launches, f64+sequential+1sites+2params
-- fusion: 39 launches without it, 9 saved (23%)
```

Each kernel under the sites that launch it, as the host recorded them:

```text
// k0: 4 launches at RMSNorm.apply/%3
kernel pow 2 (%0 : f64[batch: 4, model: 4]) -> %1 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %1[i0, i1] = (%0[i0, i1] * %0[i0, i1])
    }
  }
}
// k1: 4 launches at RMSNorm.apply/%4 (ms)
kernel mean axis model (%0 : f64[batch: 4, model: 4]) -> %1 : f64[batch: 4] {
  for i0 in 0..4 {
    s0 = 0
    for i1 in 0..4 {
      s0 = (s0 + %0[i0, i1])
    }
    %1[i0] = (s0 / 4)
  }
}
// k2: 4 launches at RMSNorm.apply/%7 (fused)
kernel fused 2 steps (%0 : f64[batch: 4], %1 : f64[]) -> %2 : f64[batch: 4] {
  for i0 in 0..4 {
    %2[i0] = sqrt((%0[i0] + %1[]))
  }
}
// k3: 3 launches at RMSNorm.apply/%10 (fused)
kernel fused 2 steps (%0 : f64[batch: 4, model: 4], %1 : f64[batch: 4], %2 : f64[4]) -> %3 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %3[i0, i1] = ((%0[i0, i1] / %1[i0]) * %2[i1])
    }
  }
}
// k4: 3 launches at Block.apply/%5
kernel gelu (%0 : f64[batch: 4, model: 4]) -> %1 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %1[i0, i1] = (%0[i0, i1] * ((1 + erf((%0[i0, i1] / 1.4142135623730951))) / 2))
    }
  }
}
// k5: 3 launches at Linear.apply/%3
kernel dot (%0 : f32[batch: 4, 4], %1 : bf16[4, 4]) -> %2 : f32[batch: 4, 4] {
  for i0 in 0..1 {
    for i1 in 0..1 {
      v0 = splat(0)
      v1 = splat(0)
      v2 = splat(0)
      v3 = splat(0)
      for i2 in 0..4 {
        s0 = %0[((i0 * 4) + 0), i2]
        s1 = %0[((i0 * 4) + 1), i2]
        s2 = %0[((i0 * 4) + 2), i2]
        s3 = %0[((i0 * 4) + 3), i2]
        v4 = %1[i2, ((i1 * 4) + 0)]<v>
        v0 = (v0 + (splat(s0) * v4)<v>)<v>
        v1 = (v1 + (splat(s1) * v4)<v>)<v>
        v2 = (v2 + (splat(s2) * v4)<v>)<v>
        v3 = (v3 + (splat(s3) * v4)<v>)<v>
      }
      %2[((i0 * 4) + 0), ((i1 * 4) + 0)] <v= v0
      %2[((i0 * 4) + 1), ((i1 * 4) + 0)] <v= v1
      %2[((i0 * 4) + 2), ((i1 * 4) + 0)] <v= v2
      %2[((i0 * 4) + 3), ((i1 * 4) + 0)] <v= v3
    }
  }
}
// k6: 3 launches at Linear.apply/%5
kernel add (%0 : f32[batch: 4, 4], %1 : f64[4]) -> %2 : f64[batch: 4, 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %2[i0, i1] = (%0[i0, i1] + %1[i1])
    }
  }
}
// k7: 3 launches at Block.apply/%8
kernel add (%0 : f64[batch: 4, model: 4], %1 : f64[batch: 4, 4]) -> %2 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %2[i0, i1] = (%0[i0, i1] + %1[i0, i1])
    }
  }
}
// k8: 1 launch at RMSNorm.apply/%10 (fused)
kernel fused 2 steps (%0 : f64[batch: 4, model: 4], %1 : f64[batch: 4], %2 : f32[4]) -> %3 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %3[i0, i1] = ((%0[i0, i1] / %1[i0]) * %2[i1])
    }
  }
}
// k9: 1 launch at loss/%6 (fused)
kernel fused 2 steps (%0 : f64[batch: 4, model: 4], %1 : f64[batch: 4, model: 4]) -> %2 : f64[batch: 4, model: 4] {
  for i0 in 0..4 {
    for i1 in 0..4 {
      %2[i0, i1] = ((%0[i0, i1] - %1[i0, i1]) * (%0[i0, i1] - %1[i0, i1]))
    }
  }
}
// k10: 1 launch at loss/%7
kernel mean (%0 : f64[batch: 4, model: 4]) -> %1 : f64[] {
  s0 = 0
  for i0 in 0..4 {
    for i1 in 0..4 {
      s0 = (s0 + %0[i0, i1])
    }
  }
  %1[] = (s0 / 16)
}
```

**The host**, as the C export prints it (§10): a function per Presk function, a fold a loop, each launch under the site it computes and each conversion where a kernel reads a value in another type.

```c
static void presk_RMSNorm_apply(presk_arena *arena, const double *theta_gamma, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* RMSNorm.apply/%3 */
    double *t3 = presk_alloc(arena, 16 * sizeof(double));
    k0(x, t3, 0, 4);
    /* RMSNorm.apply/%4 (ms) */
    double *ms = presk_alloc(arena, 4 * sizeof(double));
    k1(t3, ms, 0, 4);
    /* RMSNorm.apply/%5 */
    double *t5 = presk_alloc(arena, 1 * sizeof(double));
    presk_fill(t5, PRESK_F64, 1e-6, 1);
    /* RMSNorm.apply/%7 (fused) */
    double *t7 = presk_alloc(arena, 4 * sizeof(double));
    k2(ms, t5, t7, 0, 4);
    /* RMSNorm.apply/%10 (fused) */
    k3(x, t7, theta_gamma, out, 0, 4);
    presk_release(arena, mark);
}

/* Linear.apply at In = 4, Out = 4: 3 calls of the recording. */
static void presk_Linear_apply(presk_arena *arena, const uint16_t *theta_w, const double *theta_b, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* Linear.apply/%3 */
    float *x_f32 = presk_alloc(arena, 16 * sizeof(float));
    presk_convert(x_f32, PRESK_F32, x, PRESK_F64, 16);
    float *t3 = presk_alloc(arena, 16 * sizeof(float));
    k5(x_f32, theta_w, t3, 0, 0);
    /* Linear.apply/%5 */
    k6(t3, theta_b, out, 0, 4);
    presk_release(arena, mark);
}

/* Block.apply: 3 calls of the recording. */
static void presk_Block_apply(presk_arena *arena, const double *theta_norm_gamma, const uint16_t *theta_proj_w, const double *theta_proj_b, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* Block.apply/%4 */
    double *t4 = presk_alloc(arena, 16 * sizeof(double));
    presk_RMSNorm_apply(arena, theta_norm_gamma, x, t4);
    /* Block.apply/%5 */
    double *t5 = presk_alloc(arena, 16 * sizeof(double));
    k4(t4, t5, 0, 4);
    /* Block.apply/%7 */
    double *t7 = presk_alloc(arena, 16 * sizeof(double));
    presk_Linear_apply(arena, theta_proj_w, theta_proj_b, t5, t7);
    /* Block.apply/%8 */
    k7(x, t7, out, 0, 4);
    presk_release(arena, mark);
}

/* RMSNorm.apply at D = 4: 1 call of the recording.
 * Its other recording at these dimensions, presk_RMSNorm_apply, differs in an argument's
 * type or in an operation. */
static void presk_RMSNorm_apply_2(presk_arena *arena, const float *theta_gamma, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* RMSNorm.apply/%3 */
    double *t3 = presk_alloc(arena, 16 * sizeof(double));
    k0(x, t3, 0, 4);
    /* RMSNorm.apply/%4 (ms) */
    double *ms = presk_alloc(arena, 4 * sizeof(double));
    k1(t3, ms, 0, 4);
    /* RMSNorm.apply/%5 */
    double *t5 = presk_alloc(arena, 1 * sizeof(double));
    presk_fill(t5, PRESK_F64, 1e-6, 1);
    /* RMSNorm.apply/%7 (fused) */
    double *t7 = presk_alloc(arena, 4 * sizeof(double));
    k2(ms, t5, t7, 0, 4);
    /* RMSNorm.apply/%10 (fused) */
    k8(x, t7, theta_gamma, out, 0, 4);
    presk_release(arena, mark);
}

/* Tower.apply: 1 call of the recording. */
static void presk_Tower_apply(presk_arena *arena, const double *theta_blocks_norm_gamma, const uint16_t *theta_blocks_proj_w, const double *theta_blocks_proj_b, const float *theta_final_gamma, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* Tower.apply/%3 */
    /* a fold of 3 iterations: one loop over its 3 iterations */
    const double *x_2 = x;
    double *x_buf[2] = {presk_alloc(arena, 16 * sizeof(double)), presk_alloc(arena, 16 * sizeof(double))};
    for (int64_t l = 0; l < 3; l++) {
        presk_Block_apply(arena, theta_blocks_norm_gamma + l * 4, theta_blocks_proj_w + l * 16, theta_blocks_proj_b + l * 4, x_2, x_buf[l % 2]);
        x_2 = x_buf[l % 2];
    }
    /* Tower.apply/%6 */
    presk_RMSNorm_apply_2(arena, theta_final_gamma, x_2, out);
    presk_release(arena, mark);
}

void presk_loss(presk_arena *arena, const presk_loss_in *in, presk_loss_out *out)
{
    const double *theta_blocks_norm_gamma = in->theta_blocks_norm_gamma;
    const uint16_t *theta_blocks_proj_w = in->theta_blocks_proj_w;
    const double *theta_blocks_proj_b = in->theta_blocks_proj_b;
    const float *theta_final_gamma = in->theta_final_gamma;
    const double *batch_0 = in->batch_0;
    const double *batch_1 = in->batch_1;
    double *result = presk_alloc(arena, 1 * sizeof(double));
    const size_t mark = presk_mark(arena);
    /* loss/%4 */
    double *t4 = presk_alloc(arena, 16 * sizeof(double));
    presk_Tower_apply(arena, theta_blocks_norm_gamma, theta_blocks_proj_w, theta_blocks_proj_b, theta_final_gamma, batch_0, t4);
    /* loss/%6 (fused) */
    double *t6 = presk_alloc(arena, 16 * sizeof(double));
    k9(t4, batch_1, t6, 0, 4);
    /* loss/%7 */
    k10(t6, result, 0, 0);
    out->result = result;
    presk_release(arena, mark);
}
```

*Command:* `presk dump ../../tutorial/07_train.psk --stage kernel --entry loss --dim B=4 --plan @$DOC/artifacts/plan.json`

## 10 Targets

**Native.** The Cranelift backend compiles each of the 11 kernels to machine code at its first launch, in process, and the host program of §9 runs them.

**C.** `presk export --target c` writes the entry as a C program that computes the native backend's bits (statement C1):

```text
presk export: `loss` at B = 4 in f64+sequential+1sites+2params under the plan $DOC/artifacts/plan.json: 30 launches (0 dead, on one thread) of 11 kernels, 5 functions besides the entry's and 1 loop, an arena of 1664 bytes (4224 released nothing), into $DOC/artifacts/c; `make -C $DOC/artifacts/c check` builds it and compares it with the native backend
```

| File | Lines |
|-------------------|----------|
| `Makefile` | 22 |
| `README.md` | 66 |
| `kernels.c` | 244 |
| `main.c` | 113 |
| `model.c` | 136 |
| `model.h` | 35 |
| `presk_libm.c` | 2680 |
| `presk_rt.c` | 743 |
| `presk_rt.h` | 347 |

The first contraction, `k5`, as C:

```c
// kernel dot (%0 : f32[batch: 4, 4], %1 : bf16[4, 4]) -> %2 : f32[batch: 4, 4] {
//   for i0 in 0..1 {
//     for i1 in 0..1 {
//       v0 = splat(0)
//       v1 = splat(0)
//       v2 = splat(0)
//       v3 = splat(0)
//       for i2 in 0..4 {
//         s0 = %0[((i0 * 4) + 0), i2]
//         s1 = %0[((i0 * 4) + 1), i2]
//         s2 = %0[((i0 * 4) + 2), i2]
//         s3 = %0[((i0 * 4) + 3), i2]
//         v4 = %1[i2, ((i1 * 4) + 0)]<v>
//         v0 = (v0 + (splat(s0) * v4)<v>)<v>
//         v1 = (v1 + (splat(s1) * v4)<v>)<v>
//         v2 = (v2 + (splat(s2) * v4)<v>)<v>
//         v3 = (v3 + (splat(s3) * v4)<v>)<v>
//       }
//       %2[((i0 * 4) + 0), ((i1 * 4) + 0)] <v= v0
//       %2[((i0 * 4) + 1), ((i1 * 4) + 0)] <v= v1
//       %2[((i0 * 4) + 2), ((i1 * 4) + 0)] <v= v2
//       %2[((i0 * 4) + 3), ((i1 * 4) + 0)] <v= v3
//     }
//   }
// }
// lo, hi: unused, no loop of this kernel may be divided among threads
static void k5(const float *restrict in0, const uint16_t *restrict in1, float *restrict out, int64_t lo, int64_t hi) {
    int64_t i0 = 0, i1 = 0, i2 = 0;
    float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
    float v0[4] = {0}, v1[4] = {0}, v2[4] = {0}, v3[4] = {0}, v4[4] = {0};
    (void)lo; (void)hi;
    for (i0 = 0; i0 < 1; i0++) {
        for (i1 = 0; i1 < 1; i1++) {
            for (int l = 0; l < 4; l++) v0[l] = 0.0f;
            for (int l = 0; l < 4; l++) v1[l] = 0.0f;
            for (int l = 0; l < 4; l++) v2[l] = 0.0f;
            for (int l = 0; l < 4; l++) v3[l] = 0.0f;
            for (i2 = 0; i2 < 4; i2++) {
                s0 = in0[i0 * 16 + i2];
                s1 = in0[i0 * 16 + i2 + 4];
                s2 = in0[i0 * 16 + i2 + 8];
                s3 = in0[i0 * 16 + i2 + 12];
                for (int l = 0; l < 4; l++) v4[l] = presk_bf16_to_f32(in1[i2 * 4 + i1 * 4 + l]);
                for (int l = 0; l < 4; l++) v0[l] = v0[l] + s0 * v4[l];
                for (int l = 0; l < 4; l++) v1[l] = v1[l] + s1 * v4[l];
                for (int l = 0; l < 4; l++) v2[l] = v2[l] + s2 * v4[l];
                for (int l = 0; l < 4; l++) v3[l] = v3[l] + s3 * v4[l];
            }
            for (int l = 0; l < 4; l++) out[i0 * 16 + i1 * 4 + l] = v0[l];
            for (int l = 0; l < 4; l++) out[i0 * 16 + i1 * 4 + 4 + l] = v1[l];
            for (int l = 0; l < 4; l++) out[i0 * 16 + i1 * 4 + 8 + l] = v2[l];
            for (int l = 0; l < 4; l++) out[i0 * 16 + i1 * 4 + 12 + l] = v3[l];
        }
    }
}
```

`make -C $DOC/artifacts/c check` builds it and compares its outputs with the native backend's, bit for bit.

*Command:* `presk export ../../tutorial/07_train.psk --target c --entry loss --dim B=4 --plan @$DOC/artifacts/plan.json --threads 10 -o $DOC/artifacts/c`

## 11 Measured

What one run measured on this machine: the realization natively against the exact reference, a call timed, each kernel's time beside the model's prediction, and the host's time by phase. The one section that changes from run to run.

Not measured: `--measure` was not given. Every other section is deterministic; this one would hold times.

## 12 Sites through every stage

A site is named `<function>/%<n>` at every stage, which is what lets one value be followed from PSK-Core to the C.

By default, the three largest shares of the solver's estimate (the three largest bounds without a solve), then the three nests of the most predicted time a call; `--site` names others.

**`loss/%6`**

| Stage |  |
|------------------|------------------------------------|
| PSK-Core (§3) | `%6 : ℝ[batch: B, model: 4] = pow 2 %5` in `loss` |
| Envelope (§6.1) | \|v\| ≤ 7.476e0, 16 elements |
| Sensitivity (§6.2) | 1.000e0 |
| Type (§6.3) | `f64`, decision |
| Fusion (§7) | ends a group of 2: read by `%7 : ℝ[] = mean %6`: a reduction |
| Layout (§8) | nest `loss/%6`, 5 points at `[4, 4] [4, 4]`; chosen lanes 1, split none, 0.0125 µs, bound by work; runner-up lanes 1, split (0, 10), 101.5 µs |
| Kernel (§9) | `k9`: `kernel fused 2 steps (%0 : f64[batch: 4, model: 4], %1 : f64[batch: 4, model: 4]) -> %2 : f64[batch: 4, model: 4]` |
| C (§10) | `k9` in `kernels.c`, launched by `presk_loss` in `model.c`, the launch commented `loss/%6` |

