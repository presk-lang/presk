## 1 The source

The entry's file and the files it imports, as the compiler reads them.

**`../../tests/examples/minigpt/minigpt.psk`**

```text
  1  -- minigpt.psk — A decoder-only GPT, complete and typed.
  2  -- Illustrates: idx[V] for tokens, embeddings as a one-hot contraction (§3.5),
  3  -- causal attention through typed ein[…], Transformer blocks, stack{N}, output head.
  4  --
  5  -- Depends on: ../layernorm/layernorm.psk (LayerNorm), ../mlp/mlp.psk (Linear).
  6  import "../layernorm/layernorm.psk"  as norm
  7  import "../mlp/mlp.psk"              as ff
  8  
  9  -- ── Hyperparameters (outside the graph: evaluated statically, cf. §1) ────────────
 10  const V  : nat = 50257     -- vocabulary size
 11  const D  : nat = 768       -- model dimension
 12  const H  : nat = 12        -- number of heads
 13  const HD : nat = D / H     -- dimension per head
 14  const L  : nat = 12        -- number of blocks
 15  static assert D % H == 0   -- decidable Presburger fragment (§3.1)
 16  
 17  -- ── Symbolic dimensions (resolved at use) ────────────────────────────────────────
 18  dim B                       -- batch size
 19  dim T <= 1024               -- context length, bounded
 20  
 21  -- ── Named types, to avoid "index soup" (§3.2) ────────────────────────────────────
 22  type Tokens = idx[V][batch: B, seq: T]                 -- input: indices, NOT reals
 23  type Acts   = ℝ[batch: B, seq: T, model: D]            -- activations
 24  type Mask   = bool[seq: T, seq2: T]                    -- which positions a position sees
 25  
 26  -- ─────────────────────────────────────────────────────────────────────────────────
 27  -- Causal multi-head attention.
 28  -- ─────────────────────────────────────────────────────────────────────────────────
 29  module SelfAttention {
 30    use wq, wk, wv, wo : ff.Linear{D, D}
 31  
 32    -- split_heads : ℝ[batch, seq, model: D] -> ℝ[batch, heads: H, seq, hd: HD]
 33    -- merge_heads : the inverse. Provided by the standard library; pure axis reshuffles.
 34    fn apply(x : Acts, mask : Mask) -> Acts =
 35      let q = split_heads(wq.apply(x))
 36      let k = split_heads(wk.apply(x))
 37      let v = split_heads(wv.apply(x))
 38  
 39      -- Typed contraction: the `hd` axis is reduced, `seq`×`seq2` yields the score matrix.
 40      -- The compiler checks that `hd` appears in exactly the two operands (§3.2).
 41      let s = ein[batch, heads, seq, seq2](q * k) / sqrt(HD : ℝ)
 42  
 43      -- softmax over the positions of seq2 that the causal mask allows.
 44      let a = softmax(axis seq2, s, where = mask)
 45  
 46      -- Reweighting of the values, then output projection.
 47      let o = ein[batch, heads, seq, hd](a * v)
 48      wo.apply(merge_heads(o))
 49      -- Note: no trace of FlashAttention here. The softmax+matmul fusion is a
 50      -- scheduling strategy chosen by PSK-Realize (§8.2), not a hand-written kernel.
 51  }
 52  
 53  -- ─────────────────────────────────────────────────────────────────────────────────
 54  -- Pre-normalized Transformer block (Pre-LN), with residual connections.
 55  -- ─────────────────────────────────────────────────────────────────────────────────
 56  module Block {
 57    use attn : SelfAttention
 58    use mlp  : ff.MLP{D, 4*D}
 59    use ln1, ln2 : norm.LayerNorm{D}
 60  
 61    fn apply(x : Acts, mask : Mask) -> Acts =
 62      let x = x + attn.apply(ln1.apply(x), mask)   -- shadowing: new binding, no mutation
 63      x + mlp.apply(ln2.apply(x))
 64  }
 65  
 66  -- ─────────────────────────────────────────────────────────────────────────────────
 67  -- Token and position embeddings.
 68  -- embed denotes eₜᵀ·W (one-hot × table); compiled to a gather, never materialized (§3.5).
 69  -- ─────────────────────────────────────────────────────────────────────────────────
 70  module Embedding {
 71    param tok : param ℝ[V, D]  init = normal(std = 0.02)   -- token table
 72    param pos : param ℝ[T, D]  init = normal(std = 0.02)   -- learned position table
 73  
 74    fn apply(ids : Tokens) -> Acts =
 75      let e = embed(tok, ids)                 -- ℝ[batch, seq, model: D]; grad = scatter-add on tok
 76      let p = embed(pos, positions(seq: T))   -- positions(): idx[T] along the seq axis
 77      e + p                                    -- broadcast of p over the batch
 78  }
 79  
 80  -- ─────────────────────────────────────────────────────────────────────────────────
 81  -- The complete model: embeddings → L stacked blocks → final norm → logits.
 82  -- ─────────────────────────────────────────────────────────────────────────────────
 83  module MiniGPT {
 84    use emb    : Embedding
 85    use blocks : stack{L}(Block)     -- params stacked as ℝ[L, …]; compiled to a loop (§4.3)
 86    use lnf    : norm.LayerNorm{D}
 87    param head : param ℝ[D, V]  init = zeros    -- projection onto the vocabulary (logits)
 88  
 89    -- The causal mask is derived from the type: position i only sees j ≤ i.
 90    -- This is the property that the inference kv_cache will exploit (§7).
 91    fn apply(ids : Tokens) -> ℝ[batch: B, seq: T, vocab: V] =
 92      let mask = causal_mask(seq: T)                  -- bool[seq, seq2], true where j≤i
 93      let h0   = emb.apply(ids)
 94      let hL   = blocks.apply(h0, mask)               -- applies the L blocks in turn
 95      lnf.apply(hL) · head                            -- ℝ[batch, seq, vocab: V]
 96  }
```

**`../../tests/examples/minigpt/../layernorm/layernorm.psk`**

```text
  1  -- layernorm.psk — Layer normalization.
  2  -- Illustrates: reductions over a named axis, vector params (gain/bias),
  3  -- and the principle "numerical stability belongs to the compiler, not to the code".
  4  
  5  module LayerNorm{D : dim} {
  6    param γ : ℝ[D]  init = ones     -- gain
  7    param β : ℝ[D]  init = zeros    -- bias
  8  
  9    -- eps is NOT a numerical guard: the semantics is exact (division by the
 10    -- real standard deviation). It is a hyperparameter of the *model* (regularization), hence f64.
 11    -- The stability of sqrt and division is handled at compile time under the budget (§8.2),
 12    -- not here.
 13    fn apply(x : ℝ[..., model: D], eps : f64 = 1e-5) -> ℝ[..., model: D] =
 14      let μ  = mean(axis model, x)                 -- ℝ[...]
 15      let σ2 = mean(axis model, (x - μ)^2)         -- variance, reduction over `model`
 16      let x̂  = (x - μ) / sqrt(σ2 + real(eps))       -- real(eps): explicit f64 -> ℝ injection
 17      x̂ * γ + β                                     -- broadcast of γ, β over the leading axes
 18  }
 19  
 20  -- RMSNorm: variant without recentering, same reduction pattern.
 21  module RMSNorm{D : dim} {
 22    param γ : ℝ[D]  init = ones
 23  
 24    fn apply(x : ℝ[..., model: D], eps : f64 = 1e-6) -> ℝ[..., model: D] =
 25      let ms = mean(axis model, x^2)
 26      x / sqrt(ms + real(eps)) * γ
 27  }
```

**`../../tests/examples/minigpt/../mlp/mlp.psk`**

```text
  1  -- mlp.psk — The smallest "complete" Presk program.
  2  -- Illustrates: module, param + init, fn apply, composition, and typed grad.
  3  -- No machine precision appears: everything is exact ℝ (cf. §2).
  4  
  5  module Linear{In Out : dim} {
  6    param w : ℝ[In, Out]  init = xavier_uniform
  7    param b : ℝ[Out]      init = zeros
  8  
  9    fn apply(x : ℝ[..., In]) -> ℝ[..., Out] =
 10      x · w + b            -- "·": contraction over the last axis, broadcast of b
 11  }
 12  
 13  -- A two-layer perceptron. `hidden` is a symbolic dimension:
 14  -- the same definition serves all sizes, checked at instantiation.
 15  module MLP{D hidden : dim} {
 16    use l1 : Linear{D, hidden}
 17    use l2 : Linear{hidden, D}
 18  
 19    -- gelu is C∞; apply is therefore inferred C∞ (differentiable to any order).
 20    fn apply(x : ℝ[..., D]) -> ℝ[..., D] =
 21      l2.apply(gelu(l1.apply(x)))
 22  }
 23  
 24  -- Toy objective: mean squared error against a fixed target.
 25  -- θ is the parameter pytree generated automatically from the module's `param`s.
 26  fn mse{D : dim}(net : MLP{D, 4*D}, θ : params net, x : ℝ[batch: B, model: D],
 27                  y : ℝ[batch: B, model: D]) -> ℝ[] =
 28    let ŷ = net.apply(θ, x)
 29    mean((ŷ - y)^2)
 30  
 31  -- grad requires at least class C⁰⁺; mse is C∞ ⇒ accepted.
 32  -- The derivative is taken with respect to the parameters only (x, y are captured).
 33  fn mse_grad{D : dim}(net : MLP{D, 4*D}, θ : params net,
 34                       x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D])
 35      -> params net =
 36    grad(λ θ. mse(net, θ, x, y))(θ)
```

