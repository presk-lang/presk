## 9 The kernels and the host

PSK-Kernel is the loop nests the backends run: one kernel per distinct nest, under its type and its layout. The host program launches them, converting a value where a kernel reads it in another type.

```text
-- 24 kernels, 69 launches, f32
-- fusion: 106 launches without it, 37 saved (35%)
```

Each kernel under the sites that launch it, as the host recorded them:

```text
// k0: 1 launch at MiniGPT.apply/%2 (mask)
kernel causal_mask seq () -> %0 : i64[seq: 8, seq2: 8] {
  for i0 in 0..8 {
    for i1 in 0..8 {
      %0[i0, i1] = int(select((real(i1) <= real(i0)), 1, 0))
    }
  }
}
// k1: 1 launch at Embedding.apply/%3 (e)
kernel embed (%0 : f32[64, 16], %1 : i64[batch: 2, seq: 8]) -> %2 : f32[batch: 2, seq: 8, 16] {
  for i0 in 0..2 {
    for i1 in 0..8 {
      for i2 in 0..16 {
        %2[i0, i1, i2] = %0[%1[i0, i1], i2]
      }
    }
  }
}
// k2: 1 launch at Embedding.apply/%5
kernel positions seq () -> %0 : i64[seq: 8] {
  for i0 in 0..8 {
    %0[i0] = i0
  }
}
// k3: 1 launch at Embedding.apply/%6 (p)
kernel embed (%0 : f32[8, 16], %1 : i64[seq: 8]) -> %2 : f32[seq: 8, 16] {
  for i0 in 0..8 {
    for i1 in 0..16 {
      %2[i0, i1] = %0[%1[i0], i1]
    }
  }
}
// k4: 1 launch at Embedding.apply/%7
kernel add (%0 : f32[batch: 2, seq: 8, 16], %1 : f32[seq: 8, 16]) -> %2 : f32[batch: 2, seq: 8, 16] {
  for i0 in 0..2 {
    for i1 in 0..8 {
      for i2 in 0..16 {
        %2[i0, i1, i2] = (%0[i0, i1, i2] + %1[i1, i2])
      }
    }
  }
}
// k5: 10 launches at LayerNorm.apply/%3 (μ), LayerNorm.apply/%6 (σ2)
kernel mean axis model (%0 : f32[batch: 2, seq: 8, model: 16]) -> %1 : f32[batch: 2, seq: 8] {
  for i0 in 0..2 {
    for i1 in 0..8 {
      s0 = 0
      for i2 in 0..16 {
        s0 = (s0 + %0[i0, i1, i2])
      }
      %1[i0, i1] = (s0 / 16)
    }
  }
}
// k6: 5 launches at LayerNorm.apply/%5 (fused)
kernel fused 2 steps (%0 : f32[batch: 2, seq: 8, model: 16], %1 : f32[batch: 2, seq: 8]) -> %2 : f32[batch: 2, seq: 8, model: 16] {
  for i0 in 0..2 {
    for i1 in 0..8 {
      for i2 in 0..16 {
        %2[i0, i1, i2] = ((%0[i0, i1, i2] - %1[i0, i1]) * (%0[i0, i1, i2] - %1[i0, i1]))
```

*The first 60 of 590 lines; the whole in `listings/kernels.txt`.*

**The host**, as the C export prints it (§10): a function per Presk function, a fold a loop, each launch under the site it computes and each conversion where a kernel reads a value in another type.

```c
/* Embedding.apply at B = 2, T = 8: 1 call of the recording. */
static void presk_Embedding_apply(presk_arena *arena, const float *theta_tok, const float *theta_pos, const int64_t *ids, float *out)
{
    const size_t mark = presk_mark(arena);
    /* Embedding.apply/%3 (e) */
    float *e = presk_alloc(arena, 256 * sizeof(float));
    k1(theta_tok, ids, e, 0, 2);
    /* Embedding.apply/%5 */
    int64_t *t5 = presk_alloc(arena, 8 * sizeof(int64_t));
    k2(t5, 0, 8);
    /* Embedding.apply/%6 (p) */
    float *p = presk_alloc(arena, 128 * sizeof(float));
    k3(theta_pos, t5, p, 0, 8);
    /* Embedding.apply/%7 */
    k4(e, p, out, 0, 2);
    presk_release(arena, mark);
}

/* LayerNorm.apply at D = 16: 5 calls of the recording. */
static void presk_LayerNorm_apply(presk_arena *arena, const float *theta_gamma, const float *theta_beta, const float *x, float *out)
{
    const size_t mark = presk_mark(arena);
    /* LayerNorm.apply/%3 (μ) */
    float *mu = presk_alloc(arena, 16 * sizeof(float));
    k5(x, mu, 0, 2);
    /* LayerNorm.apply/%5 (fused) */
    float *t5 = presk_alloc(arena, 256 * sizeof(float));
    k6(x, mu, t5, 0, 2);
    /* LayerNorm.apply/%6 (σ2) */
    float *sigma2 = presk_alloc(arena, 16 * sizeof(float));
    k5(t5, sigma2, 0, 2);
    /* LayerNorm.apply/%8 */
    float *t8 = presk_alloc(arena, 1 * sizeof(float));
    presk_fill(t8, PRESK_F32, 1e-5, 1);
    /* LayerNorm.apply/%10 (fused) */
    float *t10 = presk_alloc(arena, 16 * sizeof(float));
    k7(sigma2, t8, t10, 0, 2);
    /* LayerNorm.apply/%15 (fused) */
    k8(x, mu, t10, theta_gamma, theta_beta, out, 0, 2);
    presk_release(arena, mark);
}

/* Linear.apply at In = 16, Out = 16: 8 calls of the recording. */
static void presk_Linear_apply_In16_Out16(const float *theta_w, const float *theta_b, const float *x, float *out)
{
    /* Linear.apply/%3 + Linear.apply/%5 */
    k9(x, theta_w, theta_b, out, 0, 2);
}

/* SelfAttention.apply at B = 2, T = 8: 2 calls of the recording. */
static void presk_SelfAttention_apply(presk_arena *arena, const float *theta_wq_w, const float *theta_wq_b, const float *theta_wk_w, const float *theta_wk_b, const float *theta_wv_w, const float *theta_wv_b, const float *theta_wo_w, const float *theta_wo_b, const float *x, const int64_t *mask, float *out)
{
    const size_t mark = presk_mark(arena);
    /* SelfAttention.apply/%4 */
    float *t4 = presk_alloc(arena, 256 * sizeof(float));
    presk_Linear_apply_In16_Out16(theta_wq_w, theta_wq_b, x, t4);
    /* SelfAttention.apply/%5 (q) */
    float *q = presk_alloc(arena, 256 * sizeof(float));
    k10(t4, q, 0, 2);
    /* SelfAttention.apply/%7 */
```

*The first 60 of 200 lines; the whole in `listings/host.c`.*

