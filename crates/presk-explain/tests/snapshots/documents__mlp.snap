## 9 The kernels and the host

PSK-Kernel is the loop nests the backends run: one kernel per distinct nest, under its type and its layout. The host program launches them, converting a value where a kernel reads it in another type.

```text
-- 7 kernels, 7 launches, f64+sequential+3sites
-- fusion: 8 launches without it, 1 saved (12%)
```

Each kernel under the sites that launch it, as the host recorded them:

```text
// k0: 1 launch at Linear.apply/%3
kernel dot (%0 : f32[batch: 2, 4], %1 : f32[4, 16]) -> %2 : f32[batch: 2, 16] {
  for i0 in 0..1 {
    for i1 in 0..4 {
      v0 = splat(0)
      v1 = splat(0)
      for i2 in 0..4 {
        s0 = %0[((i0 * 2) + 0), i2]
        s1 = %0[((i0 * 2) + 1), i2]
        v2 = %1[i2, ((i1 * 4) + 0)]<v>
        v0 = (v0 + (splat(s0) * v2)<v>)<v>
        v1 = (v1 + (splat(s1) * v2)<v>)<v>
      }
      %2[((i0 * 2) + 0), ((i1 * 4) + 0)] <v= v0
      %2[((i0 * 2) + 1), ((i1 * 4) + 0)] <v= v1
    }
  }
}
// k1: 1 launch at Linear.apply/%5
kernel add (%0 : f64[batch: 2, 16], %1 : f64[16]) -> %2 : f64[batch: 2, 16] {
  for i0 in 0..2 {
    for i1 in 0..16 {
      %2[i0, i1] = (%0[i0, i1] + %1[i1])
    }
  }
}
// k2: 1 launch at MLP.apply/%4
kernel gelu (%0 : f32[batch: 2, 16]) -> %1 : f32[batch: 2, 16] {
  for i0 in 0..2 {
    for i1 in 0..16 {
      %1[i0, i1] = (%0[i0, i1] * ((1 + erf((%0[i0, i1] / 1.4142135623730951))) / 2))
    }
  }
}
// k3: 1 launch at Linear.apply/%3
kernel dot (%0 : f32[batch: 2, 16], %1 : f32[16, 4]) -> %2 : f32[batch: 2, 4] {
  for i0 in 0..1 {
    for i1 in 0..1 {
      v0 = splat(0)
      v1 = splat(0)
      for i2 in 0..16 {
        s0 = %0[((i0 * 2) + 0), i2]
        s1 = %0[((i0 * 2) + 1), i2]
        v2 = %1[i2, ((i1 * 4) + 0)]<v>
        v0 = (v0 + (splat(s0) * v2)<v>)<v>
        v1 = (v1 + (splat(s1) * v2)<v>)<v>
      }
      %2[((i0 * 2) + 0), ((i1 * 4) + 0)] <v= v0
      %2[((i0 * 2) + 1), ((i1 * 4) + 0)] <v= v1
    }
  }
}
// k4: 1 launch at Linear.apply/%5
kernel add (%0 : f64[batch: 2, 4], %1 : f64[4]) -> %2 : f64[batch: 2, 4] {
  for i0 in 0..2 {
    for i1 in 0..4 {
      %2[i0, i1] = (%0[i0, i1] + %1[i1])
    }
  }
}
// k5: 1 launch at mse/%5 (fused)
kernel fused 2 steps (%0 : f32[batch: 2, 4], %1 : f32[batch: 2, model: 4]) -> %2 : f32[batch: 2, model: 4] {
  for i0 in 0..2 {
    for i1 in 0..4 {
      %2[i0, i1] = ((%0[i0, i1] - %1[i0, i1]) * (%0[i0, i1] - %1[i0, i1]))
    }
  }
}
// k6: 1 launch at mse/%6
kernel mean (%0 : f64[batch: 2, model: 4]) -> %1 : f64[] {
  s0 = 0
  for i0 in 0..2 {
    for i1 in 0..4 {
      s0 = (s0 + %0[i0, i1])
    }
  }
  %1[] = (s0 / 8)
}
```

**The host**, as the C export prints it (§10): a function per Presk function, a fold a loop, each launch under the site it computes and each conversion where a kernel reads a value in another type.

```c
/* Linear.apply at In = 4, Out = 16: 1 call of the recording. */
static void presk_Linear_apply_In4_Out16(presk_arena *arena, const double *theta_w, const double *theta_b, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* Linear.apply/%3 */
    float *x_f32 = presk_alloc(arena, 8 * sizeof(float));
    presk_convert(x_f32, PRESK_F32, x, PRESK_F64, 8);
    float *theta_w_f32 = presk_alloc(arena, 64 * sizeof(float));
    presk_convert(theta_w_f32, PRESK_F32, theta_w, PRESK_F64, 64);
    float *t3 = presk_alloc(arena, 32 * sizeof(float));
    k0(x_f32, theta_w_f32, t3, 0, 0);
    /* Linear.apply/%5 */
    double *t3_f64 = presk_alloc(arena, 32 * sizeof(double));
    presk_convert(t3_f64, PRESK_F64, t3, PRESK_F32, 32);
    k1(t3_f64, theta_b, out, 0, 2);
    presk_release(arena, mark);
}

/* Linear.apply at In = 16, Out = 4: 1 call of the recording. */
static void presk_Linear_apply_In16_Out4(presk_arena *arena, const double *theta_w, const double *theta_b, const float *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* Linear.apply/%3 */
    float *theta_w_f32 = presk_alloc(arena, 64 * sizeof(float));
    presk_convert(theta_w_f32, PRESK_F32, theta_w, PRESK_F64, 64);
    float *t3 = presk_alloc(arena, 8 * sizeof(float));
    k3(x, theta_w_f32, t3, 0, 0);
    /* Linear.apply/%5 */
    double *t3_f64 = presk_alloc(arena, 8 * sizeof(double));
    presk_convert(t3_f64, PRESK_F64, t3, PRESK_F32, 8);
    k4(t3_f64, theta_b, out, 0, 2);
    presk_release(arena, mark);
}

/* MLP.apply at D = 4, hidden = 16: 1 call of the recording. */
static void presk_MLP_apply(presk_arena *arena, const double *theta_l1_w, const double *theta_l1_b, const double *theta_l2_w, const double *theta_l2_b, const double *x, double *out)
{
    const size_t mark = presk_mark(arena);
    /* MLP.apply/%3 */
    double *t3 = presk_alloc(arena, 32 * sizeof(double));
    presk_Linear_apply_In4_Out16(arena, theta_l1_w, theta_l1_b, x, t3);
    /* MLP.apply/%4 */
    float *t3_f32 = presk_alloc(arena, 32 * sizeof(float));
    presk_convert(t3_f32, PRESK_F32, t3, PRESK_F64, 32);
    float *t4 = presk_alloc(arena, 32 * sizeof(float));
    k2(t3_f32, t4, 0, 2);
    /* MLP.apply/%6 */
    presk_Linear_apply_In16_Out4(arena, theta_l2_w, theta_l2_b, t4, out);
    presk_release(arena, mark);
}

void presk_mse(presk_arena *arena, const presk_mse_in *in, presk_mse_out *out)
{
    const double *theta_l1_w = in->theta_l1_w;
    const double *theta_l1_b = in->theta_l1_b;
    const double *theta_l2_w = in->theta_l2_w;
    const double *theta_l2_b = in->theta_l2_b;
    const double *x = in->x;
    const double *y = in->y;
    double *result = presk_alloc(arena, 1 * sizeof(double));
    const size_t mark = presk_mark(arena);
    /* mse/%3 (ŷ) */
    double *y_hat = presk_alloc(arena, 8 * sizeof(double));
    presk_MLP_apply(arena, theta_l1_w, theta_l1_b, theta_l2_w, theta_l2_b, x, y_hat);
    /* mse/%5 (fused) */
    float *y_hat_f32 = presk_alloc(arena, 8 * sizeof(float));
    presk_convert(y_hat_f32, PRESK_F32, y_hat, PRESK_F64, 8);
    float *y_f32 = presk_alloc(arena, 8 * sizeof(float));
    presk_convert(y_f32, PRESK_F32, y, PRESK_F64, 8);
    float *t5 = presk_alloc(arena, 8 * sizeof(float));
    k5(y_hat_f32, y_f32, t5, 0, 2);
    /* mse/%6 */
    double *t5_f64 = presk_alloc(arena, 8 * sizeof(double));
    presk_convert(t5_f64, PRESK_F64, t5, PRESK_F32, 8);
    k6(t5_f64, result, 0, 0);
    out->result = result;
    presk_release(arena, mark);
}
```

*Command:* `presk dump ../../tests/examples/mlp/mlp.psk --stage kernel --entry mse --dim D=4 --dim B=2 --plan @$DOC/artifacts/plan.json`

## 10 Targets

**Native.** The Cranelift backend compiles each of the 7 kernels to machine code at its first launch, in process, and the host program of §9 runs them.

## 11 Measured

What one run measured on this machine: the realization natively against the exact reference, a call timed, each kernel's time beside the model's prediction, and the host's time by phase. The one section that changes from run to run.

Not measured: `--measure` was not given. Every other section is deterministic; this one would hold times.

## 12 Sites through every stage

A site is named `<function>/%<n>` at every stage, which is what lets one value be followed from PSK-Core to the C.

By default, the three largest shares of the solver's estimate (the three largest bounds without a solve), then the three nests of the most predicted time a call; `--site` names others.

**`MLP.apply/%4`**

| Stage |  |
|------------------|------------------------------------|
| PSK-Core (§3) | `%4 : ℝ[..., hidden] = gelu %3` in `MLP.apply` |
| Envelope (§6.1) | \|v\| ≤ 6.443e-1, 32 elements |
| Sensitivity (§6.2) | 3.727e0 |
| Type (§6.3) | `f32`, decision; term 1.431e-7; narrowed to `f32` (move 1): saves 5.295e-8 s, adds 1.431e-7 to the estimate, then 1.431e-7 |
| Fusion (§7) | alone: read by `%6 : ℝ[..., D] = call Linear.apply{In = hidden, Out = D}(l2, %4)`: a call |
| Layout (§8) | nest `MLP.apply/%4`, 5 points at `[2, 16]`; chosen lanes 1, split none, 0.0357 µs, bound by work; runner-up lanes 1, split (1, 5), 101.5 µs |
| Kernel (§9) | `k2`: `kernel gelu (%0 : f32[batch: 2, 16]) -> %1 : f32[batch: 2, 16]` |

**`mse/%5`**

| Stage |  |
|------------------|------------------------------------|
| PSK-Core (§3) | `%5 : ℝ[batch: B, model: D] = pow 2 %4` in `mse` |
| Envelope (§6.1) | \|v\| ≤ 2.275e0, 8 elements |
| Sensitivity (§6.2) | 1.000e0 |
| Type (§6.3) | `f32`, decision; term 1.356e-7; narrowed to `f32` (move 3): saves 1.324e-8 s, adds 2.891e-7 to the estimate, then 7.234e-7 |
| Fusion (§7) | ends a group of 2: read by `%6 : ℝ[] = mean %5`: a reduction |
| Layout (§8) | nest `mse/%5`, 5 points at `[2, 4] [2, 4]`; chosen lanes 1, split none, 0.0062 µs, bound by work; runner-up lanes 1, split (0, 5), 101.5 µs |
| Kernel (§9) | `k5`: `kernel fused 2 steps (%0 : f32[batch: 2, 4], %1 : f32[batch: 2, model: 4]) -> %2 : f32[batch: 2, model: 4]` |

**`Linear.apply/%3`**

| Stage |  |
|------------------|------------------------|
| PSK-Core (§3) | `%3 : ℝ[..., Out] = dot x, w` in `Linear.apply` |
| Envelope (§6.1) | \|v\| ≤ 8.739e-1, 32 elements, condition number 1.664e0 |
| Sensitivity (§6.2) | 2.360e0 |
| Type (§6.3) | `f32`, decision; term 1.229e-7; narrowed to `f32` (move 2): saves 5.295e-8 s, adds 2.912e-7 to the estimate, then 4.344e-7 |
| Fusion (§7) | not an element-wise operation |
| Layout (§8) | nest `Linear.apply/%3`, 93 points at `[2, 4] [4, 16]`; chosen tiled, tile [2, 4], kblock none, order IJ, lanes 4, split none, no pack, 0.0115 µs, bound by loads; runner-up tiled, tile [2, 16], kblock none, order JI, lanes 4, split none, no pack, 0.0115 µs |
| Kernel (§9) | `k3`: `kernel dot (%0 : f32[batch: 2, 16], %1 : f32[16, 4]) -> %2 : f32[batch: 2, 4]` |

**`Linear.apply/%5`**

| Stage |  |
|------------------|------------------------|
| PSK-Core (§3) | `%5 : ℝ[..., Out] = add %3, b` in `Linear.apply` |
| Envelope (§6.1) | \|v\| ≤ 8.739e-1, 32 elements |
| Sensitivity (§6.2) | none |
| Type (§6.3) | `f64`, decision |
| Fusion (§7) | alone: the function's result |
| Layout (§8) | nest `Linear.apply/%5`, 5 points at `[2, 16] [16]`; chosen lanes 1, split none, 0.0115 µs, bound by work; runner-up lanes 1, split (0, 10), 101.5 µs |
| Kernel (§9) | `k1`: `kernel add (%0 : f64[batch: 2, 16], %1 : f64[16]) -> %2 : f64[batch: 2, 16]` |

*Every site of the functions the entry reaches, its line and the sections that name it, in `listings/site-index.tsv` (14 lines).*

## Appendix: the commands

The commands behind the sections, in order, run from the directory the program was named from, with `DOC` set to this document's directory.

```sh
presk check ../../tests/examples/mlp/mlp.psk
presk dump ../../tests/examples/mlp/mlp.psk --stage elab
presk check ../../tests/examples/mlp/mlp.psk --summary
presk dump ../../tests/examples/mlp/mlp.psk --stage core
presk calibrate --precision ../../tests/examples/mlp/mlp.psk --entry mse --dim D=4 --dim B=2 --bits 128 --out $DOC/artifacts/envelope.json
presk dump ../../tests/examples/mlp/mlp.psk --stage sensitivity --entry mse --dim D=4 --dim B=2 --sites 30
presk solve ../../tests/examples/mlp/mlp.psk --precision $DOC/artifacts/envelope.json --budget 1e-3 --profile tests/data/x925-frozen.json --sites 30 --out $DOC/artifacts/realization.json
presk check --precision $DOC/artifacts/envelope.json ../../tests/examples/mlp/mlp.psk --realize @$DOC/artifacts/realization.json --model all --sites 8 --measure
presk dump ../../tests/examples/mlp/mlp.psk --stage realize --plan @$DOC/artifacts/plan.json
PRESK_THREADS=10 presk plan ../../tests/examples/mlp/mlp.psk --entry mse --dim D=4 --dim B=2 --realize @$DOC/artifacts/realization.json --profile tests/data/x925-frozen.json --out $DOC/artifacts/plan.json
presk dump ../../tests/examples/mlp/mlp.psk --stage kernel --entry mse --dim D=4 --dim B=2 --plan @$DOC/artifacts/plan.json
```
