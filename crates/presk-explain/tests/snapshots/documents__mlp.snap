## 1 The source

The entry's file and the files it imports, as the compiler reads them.

**`../../tests/examples/mlp/mlp.psk`**

```text
  1  -- mlp.psk — The smallest "complete" Presk program.
  2  -- Illustrates: module, param + init, fn apply, composition, and typed grad.
  3  -- No machine precision appears: everything is exact ℝ (cf. §2).
  4  
  5  module Linear{In Out : dim} {
  6    param w : ℝ[In, Out]  init = xavier_uniform
  7    param b : ℝ[Out]      init = zeros
  8  
  9    fn apply(x : ℝ[..., In]) -> ℝ[..., Out] =
 10      x · w + b            -- "·": contraction over the last axis, broadcast of b
 11  }
 12  
 13  -- A two-layer perceptron. `hidden` is a symbolic dimension:
 14  -- the same definition serves all sizes, checked at instantiation.
 15  module MLP{D hidden : dim} {
 16    use l1 : Linear{D, hidden}
 17    use l2 : Linear{hidden, D}
 18  
 19    -- gelu is C∞; apply is therefore inferred C∞ (differentiable to any order).
 20    fn apply(x : ℝ[..., D]) -> ℝ[..., D] =
 21      l2.apply(gelu(l1.apply(x)))
 22  }
 23  
 24  -- Toy objective: mean squared error against a fixed target.
 25  -- θ is the parameter pytree generated automatically from the module's `param`s.
 26  fn mse{D : dim}(net : MLP{D, 4*D}, θ : params net, x : ℝ[batch: B, model: D],
 27                  y : ℝ[batch: B, model: D]) -> ℝ[] =
 28    let ŷ = net.apply(θ, x)
 29    mean((ŷ - y)^2)
 30  
 31  -- grad requires at least class C⁰⁺; mse is C∞ ⇒ accepted.
 32  -- The derivative is taken with respect to the parameters only (x, y are captured).
 33  fn mse_grad{D : dim}(net : MLP{D, 4*D}, θ : params net,
 34                       x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D])
 35      -> params net =
 36    grad(λ θ. mse(net, θ, x, y))(θ)
```

