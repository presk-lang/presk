-- regularity and effects --
LayerNorm.apply : [θ C∞, x C∞, eps C∞] uses none
RMSNorm.apply : [θ C∞, x C∞, eps C∞] uses none
LayerNorm.init : [key C∞] uses Rand
RMSNorm.init : [key C∞] uses Rand
