== tests/examples/minigpt/../layernorm/layernorm.psk
module LayerNorm{D : dim} {
  param γ : ℝ[D]  init
  param β : ℝ[D]  init
  fn apply(x : ℝ[..., model: D], eps : f64 = …) -> ℝ[..., model: D]
}
module RMSNorm{D : dim} {
  param γ : ℝ[D]  init
  fn apply(x : ℝ[..., model: D], eps : f64 = …) -> ℝ[..., model: D]
}
== tests/examples/minigpt/../mlp/mlp.psk
module Linear{In Out : dim} {
  param w : ℝ[In, Out]  init
  param b : ℝ[Out]  init
  fn apply(x : ℝ[..., In]) -> ℝ[..., Out]
}
module MLP{D hidden : dim} {
  use l1 : Linear{D, hidden}
  use l2 : Linear{hidden, D}
  fn apply(x : ℝ[..., D]) -> ℝ[..., D]
}
fn mse{D : dim}(net : MLP{D, 4*D}, θ : params MLP{D, 4*D}, x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D]) -> ℝ[]   -- implicit dims: B
fn mse_grad{D : dim}(net : MLP{D, 4*D}, θ : params MLP{D, 4*D}, x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D]) -> params MLP{D, 4*D}   -- implicit dims: B
== tests/examples/minigpt/minigpt.psk
import norm = tests/examples/minigpt/../layernorm/layernorm.psk
import ff = tests/examples/minigpt/../mlp/mlp.psk
const V = 50257
const D = 768
const H = 12
const HD = 64
const L = 12
dim B
dim T <= 1024
type Tokens = idx[50257][batch: B, seq: T]
type Acts = ℝ[batch: B, seq: T, model: 768]
type Mask = ℝ[seq: T, seq2: T]
module SelfAttention {
  use wq : Linear{768, 768}
  use wk : Linear{768, 768}
  use wv : Linear{768, 768}
  use wo : Linear{768, 768}
  fn apply(x : ℝ[batch: B, seq: T, model: 768], mask : ℝ[seq: T, seq2: T]) -> ℝ[batch: B, seq: T, model: 768]
}
module Block {
  use attn : SelfAttention
  use mlp : MLP{768, 3072}
  use ln1 : LayerNorm{768}
  use ln2 : LayerNorm{768}
  fn apply(x : ℝ[batch: B, seq: T, model: 768], mask : ℝ[seq: T, seq2: T]) -> ℝ[batch: B, seq: T, model: 768]
}
module Embedding {
  param tok : ℝ[50257, 768]  init
  param pos : ℝ[T, 768]  init
  fn apply(ids : idx[50257][batch: B, seq: T]) -> ℝ[batch: B, seq: T, model: 768]
}
module MiniGPT {
  param head : ℝ[768, 50257]  init
  use emb : Embedding
  use blocks : stack{12}(Block)
  use lnf : LayerNorm{768}
  fn apply(ids : idx[50257][batch: B, seq: T]) -> ℝ[batch: B, seq: T, vocab: 50257]
}
static assert #1: discharged
