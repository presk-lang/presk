# Generated by `presk export --target pytorch --mode readable` from tests/examples/minigpt/serve_minigpt.psk.
# Do not edit by hand. Structure and names mirror the Presk source; shapes are
# given as comments in Presk notation. Presk's semantics is exact over ℝ; this
# export runs in the dtype of its inputs (float32 by default) and cannot
# guarantee the error budget declared in the source, which is reproduced as a comment.
import math
import torch
import torch.nn as nn
import torch.nn.functional as F
from minigpt import *


def _split_heads(x, H, HD):
    """ℝ[..., seq, model] -> ℝ[..., heads, seq, hd] (Presk's `split_heads`)."""
    return x.view(*x.shape[:-1], H, HD).transpose(-3, -2)


def _merge_heads(x, H, HD):
    """ℝ[..., heads, seq, hd] -> ℝ[..., seq, model] (Presk's `merge_heads`)."""
    return x.transpose(-3, -2).reshape(*x.shape[:-3], x.shape[-2], H * HD)


# dimensions B, T: symbolic, taken from the arguments' shapes
def next_token(θ, ctx, temperature=0.8, generator=None, training=False):
    """Generated from `fn next_token` (serve_minigpt.psk:9)."""
    # θ : params MiniGPT
    # ctx : idx[50257][batch: B, seq: T]
    B = ctx.shape[0]
    T = ctx.shape[1]
    # temperature : f64
    logits = torch.func.functional_call(MiniGPT(T), θ, (ctx,))  # ℝ[batch: B, seq: T, vocab: 50257]
    last = logits[:, -1]  # ℝ[batch: B, vocab: 50257]
    return torch.multinomial(torch.softmax((last / temperature), dim=-1), 1, generator=generator).squeeze(-1)

