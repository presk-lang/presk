# Generated by `presk export --serve` from tests/examples/minigpt/serve_minigpt.psk. Do not edit by hand.
# The `inference serve` of the source as a PyTorch generation loop: the model
# `MiniGPT` with the weights of `final.pt` (train.py) or of a `params MiniGPT`
# .psk.d checkpoint (presk train), the prompt as token indices, then
# `--tokens` steps of the generation function `next_token` (sampling from
# PyTorch's generator seeded by --seed, not from the Presk key, which is passed
# as None: other tokens than `presk serve`'s) or of argmax over the model's last
# position when `--temperature 0` (greedy, the path `presk serve` compares bit
# for bit).
# When the parameters fix the context length (`--dim T=N`, default the
# prompt's length), the model sees the last N tokens: a sliding window.
# Fields of the block without effect here, as in `presk serve`: precision, target, batching, cache.
import argparse
import os

import torch

from minigpt import *
from serve_minigpt import next_token
from pskd import read_params

HERE = os.path.dirname(os.path.abspath(__file__))
WEIGHTS = os.path.join(HERE, "ckpt/final.psk.d")
CTOR_DIMS = ["T"]
SEQ_DIM = "T"
LAYOUT = {"head": None, "blocks": ["stack", {"w": None}]}


def make_model(dims):
    return MiniGPT(dims["T"])


def load_weights(model, path):
    if path.endswith(".pt"):
        model.load_state_dict(torch.load(path, map_location="cpu"))
    else:
        model.load_state_dict(read_params(path, LAYOUT, model))
    return model


def main():
    ap = argparse.ArgumentParser(description="Generate tokens with the model of the Presk source.")
    ap.add_argument("--weights", default=WEIGHTS, help="final.pt or a params .psk.d checkpoint")
    ap.add_argument("--prompt", required=True, help="token indices separated by spaces")
    ap.add_argument("--tokens", type=int, default=16)
    ap.add_argument("--temperature", type=float, default=0.8, help="0 is greedy")
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--dtype", default="float32", choices=["float32", "float64"])
    ap.add_argument("--dim", action="append", default=[], metavar="NAME=N", help="a dimension of the model not fixed by the prompt")
    args = ap.parse_args()
    if args.weights is None:
        raise SystemExit("no weights: give --weights")
    dtype = getattr(torch, args.dtype)
    prompt = [int(t) for t in args.prompt.split()]
    dims = dict((n, int(v)) for n, v in (d.split("=") for d in args.dim))
    window = None
    if SEQ_DIM is not None and SEQ_DIM in CTOR_DIMS:
        window = dims.setdefault(SEQ_DIM, len(prompt))
        if len(prompt) < window:
            raise SystemExit(f"the prompt has {len(prompt)} tokens but the model's context length is {SEQ_DIM} = {window}")
    model = load_weights(make_model(dims).to(dtype), args.weights).eval()
    theta = dict(model.named_parameters())
    torch.manual_seed(args.seed)
    tokens = list(prompt)
    generated = []
    with torch.no_grad():
        for _ in range(args.tokens):
            ctx = torch.tensor([tokens[-window:] if window else tokens], dtype=torch.long)
            if args.temperature == 0:
                nxt = model(ctx)[:, -1].argmax(-1)
            else:
                nxt = next_token(theta, None, ctx, args.temperature)
            tok = int(nxt.reshape(-1)[0])
            generated.append(tok)
            tokens.append(tok)
    print(" ".join(str(t) for t in generated))


if __name__ == "__main__":
    main()
