# Generated by `presk export --target pytorch --mode readable` from examples/spec/minigpt/minigpt.psk.
# Do not edit by hand. Structure and names mirror the Presk source; shapes are
# given as comments in Presk notation. Presk's semantics is exact over ℝ; this
# export runs in the dtype of its inputs (float32 by default) and cannot
# guarantee the error budget declared in the source, which is reproduced as a comment.
import math
import torch
import torch.nn as nn
import torch.nn.functional as F
from layernorm import *
from mlp import *


def _split_heads(x, H, HD):
    """ℝ[..., seq, model] -> ℝ[..., heads, seq, hd] (Presk's `split_heads`)."""
    return x.view(*x.shape[:-1], H, HD).transpose(-3, -2)


def _merge_heads(x, H, HD):
    """ℝ[..., heads, seq, hd] -> ℝ[..., seq, model] (Presk's `merge_heads`)."""
    return x.transpose(-3, -2).reshape(*x.shape[:-3], x.shape[-2], H * HD)

V = 50257
D = 768
H = 12
HD = 64
L = 12
assert D % H == 0, "static assert D % H == 0"
# dim B  (symbolic)
# dim T <= 1024  (symbolic; bound checked where the dimension is bound)
# type Tokens = idx[50257][batch: B, seq: T]
# type Acts = ℝ[batch: B, seq: T, model: 768]
# type Mask = bool[seq: T, seq2: T]

class SelfAttention(nn.Module):
    """Generated from `module SelfAttention` (minigpt.psk:29). Do not edit by hand."""

    def __init__(self):
        super().__init__()
        self.wq = Linear(768, 768)
        self.wk = Linear(768, 768)
        self.wv = Linear(768, 768)
        self.wo = Linear(768, 768)

    def forward(self, x, mask):
        """Generated from `fn apply` (minigpt.psk:34)."""
        # x : ℝ[batch: B, seq: T, model: 768]
        B = x.shape[0]
        T = x.shape[1]
        assert x.shape == (B, T, 768,), f"x: expected ℝ[batch: B, seq: T, model: 768] " + str(tuple(x.shape))
        # mask : bool[seq: T, seq2: T]
        assert mask.shape == (T, T,), f"mask: expected bool[seq: T, seq2: T] " + str(tuple(mask.shape))
        q = _split_heads(self.wq(x), H, HD)  # ℝ[batch: B, heads: 12, seq: T, hd: 64]
        assert q.shape == (B, 12, T, 64,), str(tuple(q.shape))
        k = _split_heads(self.wk(x), H, HD)  # ℝ[batch: B, heads: 12, seq: T, hd: 64]
        assert k.shape == (B, 12, T, 64,), str(tuple(k.shape))
        v = _split_heads(self.wv(x), H, HD)  # ℝ[batch: B, heads: 12, seq: T, hd: 64]
        assert v.shape == (B, 12, T, 64,), str(tuple(v.shape))
        s = torch.einsum("abcd,abed->abce", q, k) / math.sqrt(float(HD))  # ℝ[batch: B, heads: 12, seq: T, seq2: T]
        assert s.shape == (B, 12, T, T,), str(tuple(s.shape))
        a = torch.softmax(s.masked_fill(~mask, float("-inf")), dim=3)  # ℝ[batch: B, heads: 12, seq: T, seq2: T]
        assert a.shape == (B, 12, T, T,), str(tuple(a.shape))
        o = torch.einsum("abcd,abde->abce", a, v)  # ℝ[batch: B, heads: 12, seq: T, hd: 64]
        assert o.shape == (B, 12, T, 64,), str(tuple(o.shape))
        return self.wo(_merge_heads(o, H, HD))

class Block(nn.Module):
    """Generated from `module Block` (minigpt.psk:56). Do not edit by hand."""

    def __init__(self):
        super().__init__()
        self.attn = SelfAttention()
        self.mlp = MLP(768, 3072)
        self.ln1 = LayerNorm(768)
        self.ln2 = LayerNorm(768)

    def forward(self, x, mask):
        """Generated from `fn apply` (minigpt.psk:61)."""
        # x : ℝ[batch: B, seq: T, model: 768]
        B = x.shape[0]
        T = x.shape[1]
        assert x.shape == (B, T, 768,), f"x: expected ℝ[batch: B, seq: T, model: 768] " + str(tuple(x.shape))
        # mask : bool[seq: T, seq2: T]
        assert mask.shape == (T, T,), f"mask: expected bool[seq: T, seq2: T] " + str(tuple(mask.shape))
        x = x + self.attn(self.ln1(x), mask)  # ℝ[batch: B, seq: T, model: 768]
        assert x.shape == (B, T, 768,), str(tuple(x.shape))
        return x + self.mlp(self.ln2(x))

class Embedding(nn.Module):
    """Generated from `module Embedding` (minigpt.psk:70). Do not edit by hand."""

    def __init__(self, T):
        super().__init__()
        self.T = T
        self.tok = nn.init.normal_(nn.Parameter(torch.empty(50257, 768)), std=0.02)  # ℝ[50257, 768]
        self.pos = nn.init.normal_(nn.Parameter(torch.empty(T, 768)), std=0.02)  # ℝ[T, 768]

    def forward(self, ids):
        """Generated from `fn apply` (minigpt.psk:74)."""
        # ids : idx[50257][batch: B, seq: T]
        B = ids.shape[0]
        assert ids.shape == (B, self.T,), f"ids: expected idx[50257][batch: B, seq: T] " + str(tuple(ids.shape))
        e = self.tok[ids]  # ℝ[batch: B, seq: T, 768]
        assert e.shape == (B, self.T, 768,), str(tuple(e.shape))
        p = self.pos[torch.arange(self.T)]  # ℝ[seq: T, 768]
        assert p.shape == (self.T, 768,), str(tuple(p.shape))
        return e + p

class MiniGPT(nn.Module):
    """Generated from `module MiniGPT` (minigpt.psk:83). Do not edit by hand."""

    def __init__(self, T):
        super().__init__()
        self.T = T
        self.emb = Embedding(self.T)
        self.blocks = nn.ModuleList([Block() for _ in range(12)])
        self.lnf = LayerNorm(768)
        self.head = nn.Parameter(torch.zeros(768, 50257))  # ℝ[768, 50257]

    def forward(self, ids):
        """Generated from `fn apply` (minigpt.psk:91)."""
        # ids : idx[50257][batch: B, seq: T]
        B = ids.shape[0]
        assert ids.shape == (B, self.T,), f"ids: expected idx[50257][batch: B, seq: T] " + str(tuple(ids.shape))
        mask = torch.ones((self.T, self.T), dtype=torch.bool).tril()  # bool[seq: T, seq2: T]
        assert mask.shape == (self.T, self.T,), str(tuple(mask.shape))
        h0 = self.emb(ids)  # ℝ[batch: B, seq: T, model: 768]
        assert h0.shape == (B, self.T, 768,), str(tuple(h0.shape))
        hL = h0
        for block in self.blocks:  # stack{12}
            hL = block(hL, mask)
        assert hL.shape == (B, self.T, 768,), str(tuple(hL.shape))
        return self.lnf(hL) @ self.head
