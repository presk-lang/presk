# Generated by `presk export --train` from examples/spec/minigpt/train_minigpt.psk. Do not edit by hand.
# The `training run` of the source as a PyTorch loop: the same data file (copied
# next to this script), the same batch size, AdamW with the block's
# hyperparameters, the same schedule (cosine(warmup = 2000)), `clip_grad_norm_` for
# `grad_clip`. Shuffling is PyTorch's (the .psk.d pipeline's permutation is
# not reproduced; the K-step conformance test replays the interpreter's
# batches). The batch axis is the leading axis of every tensor of the batch.
# Dimensions fixed by the run: B = 32, T = 8.
# The `parallel` and `precision` clauses are reproduced as comments in train_minigpt.py.
import argparse
import math
import os
import statistics
import time

import torch
from torch.utils.data import DataLoader

from minigpt import *
from train_minigpt import loss
from pskd import PskdDataset

HERE = os.path.dirname(os.path.abspath(__file__))
OBJECTIVE = loss
LR, BETAS, EPS, WEIGHT_DECAY = 3e-4, (0.9, 0.95), 1e-8, 0.1
GRAD_CLIP = 1.0
BATCH, SHUFFLE_SEED, EPOCHS = 32, 1234, 10
CHECKPOINT_EVERY, CHECKPOINT_DIR = 1000, "ckpt/"
DATA = os.path.join(HERE, "data.psk.d")


def schedule(t, total):
    """Learning-rate multiplier at step t (from 1) of total: cosine(warmup = 2000)."""
    t, total = float(t), float(total)
    return min(1.0, t / 2000) * 0.5 * (1.0 + math.cos(math.pi * min(1.0, max(0.0, (t - 2000) / max(total - 2000, 1.0)))))


def make_model():
    return MiniGPT(8)


def step_loss(theta, batch):
    """The objective on one batch, as the loop calls it."""
    return loss(theta, batch)


def main():
    ap = argparse.ArgumentParser(description="Train the model of the Presk source with PyTorch.")
    ap.add_argument("--data", default=DATA, help=".psk.d file of samples")
    ap.add_argument("--steps", type=int, default=None, help="stop after N steps (the schedule's horizon becomes N)")
    ap.add_argument("--epochs", type=int, default=EPOCHS)
    ap.add_argument("--ckpt", default=CHECKPOINT_DIR, help="checkpoint directory (final.pt is written there)")
    ap.add_argument("--dtype", default="float32", choices=["float32", "float64"])
    ap.add_argument("--seed", type=int, default=0, help="seed of the parameter initialization")
    ap.add_argument("--log-every", type=int, default=1)
    ap.add_argument("--threads", type=int, default=None, help="intra-op threads (default: the machine's cores)")
    args = ap.parse_args()

    torch.manual_seed(args.seed)
    torch.set_num_threads(args.threads or os.cpu_count())
    dtype = getattr(torch, args.dtype)
    print(f"train.py: torch {torch.__version__} on cpu, {torch.get_num_threads()} threads, {args.dtype}")
    dataset = PskdDataset(args.data, dtype)
    generator = torch.Generator().manual_seed(SHUFFLE_SEED) if SHUFFLE_SEED is not None else None
    loader = DataLoader(dataset, batch_size=BATCH, shuffle=SHUFFLE_SEED is not None, drop_last=True, generator=generator)
    model = make_model().to(dtype)
    theta = dict(model.named_parameters())
    opt = torch.optim.AdamW(model.parameters(), lr=LR, betas=BETAS, eps=EPS, weight_decay=WEIGHT_DECAY)
    total = args.steps if args.steps is not None else args.epochs * len(loader)
    ckpt = os.path.join(HERE, args.ckpt) if args.ckpt and not os.path.isabs(args.ckpt) else args.ckpt
    if ckpt:
        os.makedirs(ckpt, exist_ok=True)
    t, start, times = 0, time.time(), []
    for epoch in range(1, args.epochs + 1):
        for batch in loader:
            t += 1
            t0 = time.perf_counter()
            for group in opt.param_groups:
                group["lr"] = LR * schedule(t, total)
            opt.zero_grad()
            value = step_loss(theta, batch)
            value.backward()
            if GRAD_CLIP is not None:
                torch.nn.utils.clip_grad_norm_(model.parameters(), GRAD_CLIP)
            opt.step()
            times.append(time.perf_counter() - t0)
            if args.log_every and t % args.log_every == 0:
                print(f"step {t}/{total}  epoch {epoch}  loss {value.item():.6f}  lr {opt.param_groups[0]['lr']:.3e}")
            if ckpt and CHECKPOINT_EVERY and t % CHECKPOINT_EVERY == 0:
                torch.save(model.state_dict(), os.path.join(ckpt, f"step-{t}.pt"))
            if t >= total:
                break
        if t >= total:
            break
    if ckpt:
        torch.save(model.state_dict(), os.path.join(ckpt, "final.pt"))
    if len(times) > 1:
        # The step's wall time, the first excluded (it pays the allocations
        # and the kernels' warm-up), as `presk train` reports it.
        print(f"train.py: {1e3 * statistics.median(times[1:]):.1f} ms a step, median of {len(times) - 1} (the first excluded)")
    print(f"train.py: {t} steps in {time.time() - start:.1f} s, final loss {value.item():.6f}" + (f", weights in {ckpt}/final.pt" if ckpt else ""))


if __name__ == "__main__":
    main()
