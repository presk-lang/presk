# Generated by `presk export --target pytorch --mode readable` from tests/examples/mlp/mlp.psk.
# Do not edit by hand. Structure and names mirror the Presk source; shapes are
# given as comments in Presk notation. Presk's semantics is exact over ℝ; this
# export runs in the dtype of its inputs (float32 by default) and cannot
# guarantee the error budget declared in the source, which is reproduced as a comment.
import math
import torch
import torch.nn as nn
import torch.nn.functional as F


def _split_heads(x, H, HD):
    """ℝ[..., seq, model] -> ℝ[..., heads, seq, hd] (Presk's `split_heads`)."""
    return x.view(*x.shape[:-1], H, HD).transpose(-3, -2)


def _merge_heads(x, H, HD):
    """ℝ[..., heads, seq, hd] -> ℝ[..., seq, model] (Presk's `merge_heads`)."""
    return x.transpose(-3, -2).reshape(*x.shape[:-3], x.shape[-2], H * HD)


class Linear(nn.Module):
    """Generated from `module Linear` (mlp.psk:5). Do not edit by hand."""

    def __init__(self, In, Out):
        super().__init__()
        self.In = In
        self.Out = Out
        self.w = nn.init.xavier_uniform_(nn.Parameter(torch.empty(self.In, self.Out)))  # ℝ[In, Out]
        self.b = nn.Parameter(torch.zeros(self.Out))  # ℝ[Out]

    def forward(self, x):
        """Generated from `fn apply` (mlp.psk:9)."""
        # x : ℝ[..., In]
        return x @ self.w + self.b

class MLP(nn.Module):
    """Generated from `module MLP` (mlp.psk:15). Do not edit by hand."""

    def __init__(self, D, hidden):
        super().__init__()
        self.D = D
        self.hidden = hidden
        self.l1 = Linear(self.D, self.hidden)
        self.l2 = Linear(self.hidden, self.D)

    def forward(self, x):
        """Generated from `fn apply` (mlp.psk:20)."""
        # x : ℝ[..., D]
        return self.l2(F.gelu(self.l1(x)))

# dimensions D, B: symbolic, taken from the arguments' shapes
def mse(net, θ, x, y):
    """Generated from `fn mse` (mlp.psk:26)."""
    # net : MLP{D, 4*D}  (a module, passed as an nn.Module)
    # θ : params MLP{D, 4*D}
    # x : ℝ[batch: B, model: D]
    B = x.shape[0]
    D = x.shape[1]
    # y : ℝ[batch: B, model: D]
    ŷ = torch.func.functional_call(net, θ, (x,))  # ℝ[batch: B, D]
    return ((ŷ - y) ** 2).mean()

# dimensions D, B: symbolic, taken from the arguments' shapes
def mse_grad(net, θ, x, y):
    """Generated from `fn mse_grad` (mlp.psk:33)."""
    # net : MLP{D, 4*D}  (a module, passed as an nn.Module)
    # θ : params MLP{D, 4*D}
    # x : ℝ[batch: B, model: D]
    B = x.shape[0]
    D = x.shape[1]
    # y : ℝ[batch: B, model: D]
    return torch.func.grad((lambda θ: mse(net, θ, x, y)))(θ)
