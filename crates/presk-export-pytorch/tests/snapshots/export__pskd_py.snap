# Generated by `presk export`: a reader of Presk `.psk.d` data files.
# A .psk.d file is a sequence of samples of one Presk type: header (magic
# "PSKD", version u16, the type in Presk syntax, count u64), then the samples
# back to back — idx[N] as the smallest of u8/u16/u32/u64 holding N−1, ℝ as
# f64, little-endian, tensors in row-major order, tuples leaf by leaf.
import re
import struct

import numpy as np
import torch
from torch.utils.data import Dataset


def _parse_type(text):
    """The leaf layout of a closed sample type: a nested list of ("idx", N, shape) / ("real", shape)."""
    pos = [0]

    def ws():
        while pos[0] < len(text) and text[pos[0]].isspace():
            pos[0] += 1

    def axes():
        assert text[pos[0]] == "["
        pos[0] += 1
        shape = []
        while True:
            ws()
            if text[pos[0]] == "]":
                pos[0] += 1
                return shape
            m = re.match(r"(?:[^\W\d]\w*\s*:\s*)?(\d+)", text[pos[0]:])
            assert m, f"bad axis at {text[pos[0]:]!r}"
            shape.append(int(m.group(1)))
            pos[0] += m.end()
            ws()
            if text[pos[0]] == ",":
                pos[0] += 1

    def ty():
        ws()
        if text.startswith("(", pos[0]):
            pos[0] += 1
            elems = []
            while True:
                elems.append(ty())
                ws()
                if text[pos[0]] == ",":
                    pos[0] += 1
                    continue
                assert text[pos[0]] == ")"
                pos[0] += 1
                return ("tuple", elems)
        if text.startswith("idx", pos[0]):
            pos[0] += 3
            ws()
            bound = axes()
            assert len(bound) == 1
            ws()
            shape = axes() if pos[0] < len(text) and text[pos[0]] == "[" else []
            return ("idx", bound[0], shape)
        for kw in ("ℝ", "Real"):
            if text.startswith(kw, pos[0]):
                pos[0] += len(kw)
                ws()
                shape = axes() if pos[0] < len(text) and text[pos[0]] == "[" else []
                return ("real", shape)
        raise ValueError(f"not a data type: {text!r}")

    return ty()


def _idx_dtype(bound):
    n = bound - 1
    return np.uint8 if n <= 0xFF else np.uint16 if n <= 0xFFFF else np.uint32 if n <= 0xFFFFFFFF else np.uint64


def _leaves(layout):
    if layout[0] == "tuple":
        return [l for e in layout[1] for l in _leaves(e)]
    return [layout]


def _sample_bytes(layout):
    total = 0
    for leaf in _leaves(layout):
        n = int(np.prod(leaf[-1])) if leaf[-1] else 1
        total += n * (np.dtype(_idx_dtype(leaf[1])).itemsize if leaf[0] == "idx" else 8)
    return total


class PskdDataset(Dataset):
    """Samples of a .psk.d file as tensors (idx leaves as int64, reals as `dtype`);
    a tuple sample is a tuple of tensors."""

    def __init__(self, path, dtype=torch.float32):
        with open(path, "rb") as f:
            magic = f.read(4)
            if magic != b"PSKD":
                raise ValueError(f"{path}: not a .psk.d file")
            (version,) = struct.unpack("<H", f.read(2))
            if version != 1:
                raise ValueError(f"{path}: .psk.d version {version}, this reader knows version 1")
            (tlen,) = struct.unpack("<I", f.read(4))
            self.type_text = f.read(tlen).decode("utf-8")
            (self.count,) = struct.unpack("<Q", f.read(8))
            self.data = f.read()
        self.layout = _parse_type(self.type_text)
        self.size = _sample_bytes(self.layout)
        if len(self.data) < self.count * self.size:
            raise ValueError(f"{path}: truncated")
        self.dtype = dtype

    def __len__(self):
        return self.count

    def _decode(self, layout, buf, pos):
        if layout[0] == "tuple":
            out = []
            for e in layout[1]:
                v, pos = self._decode(e, buf, pos)
                out.append(v)
            return tuple(out), pos
        shape = layout[-1]
        n = int(np.prod(shape)) if shape else 1
        if layout[0] == "idx":
            dt = _idx_dtype(layout[1])
            arr = np.frombuffer(buf, dtype=dt, count=n, offset=pos).astype(np.int64)
            pos += n * np.dtype(dt).itemsize
            return torch.from_numpy(arr.reshape(shape)), pos
        arr = np.frombuffer(buf, dtype="<f8", count=n, offset=pos)
        pos += 8 * n
        return torch.from_numpy(arr.reshape(shape).copy()).to(self.dtype), pos

    def __getitem__(self, i):
        if i < 0 or i >= self.count:
            raise IndexError(i)
        v, _ = self._decode(self.layout, self.data, i * self.size)
        return v


def collate(samples):
    """Stacks samples along a new leading (batch) axis, leaf by leaf."""
    if isinstance(samples[0], tuple):
        return tuple(collate([s[k] for s in samples]) for k in range(len(samples[0])))
    return torch.stack(list(samples))
