# Generated by `presk export --target pytorch --mode readable` from tests/examples/layernorm/layernorm.psk.
# Do not edit by hand. Structure and names mirror the Presk source; shapes are
# given as comments in Presk notation. Presk's semantics is exact over ℝ; this
# export runs in the dtype of its inputs (float32 by default) and cannot
# guarantee the error budget declared in the source, which is reproduced as a comment.
import math
import torch
import torch.nn as nn
import torch.nn.functional as F


def _split_heads(x, H, HD):
    """ℝ[..., seq, model] -> ℝ[..., heads, seq, hd] (Presk's `split_heads`)."""
    return x.view(*x.shape[:-1], H, HD).transpose(-3, -2)


def _merge_heads(x, H, HD):
    """ℝ[..., heads, seq, hd] -> ℝ[..., seq, model] (Presk's `merge_heads`)."""
    return x.transpose(-3, -2).reshape(*x.shape[:-3], x.shape[-2], H * HD)


class LayerNorm(nn.Module):
    """Generated from `module LayerNorm` (layernorm.psk:5). Do not edit by hand."""

    def __init__(self, D):
        super().__init__()
        self.D = D
        self.γ = nn.Parameter(torch.ones(self.D))  # ℝ[D]
        self.β = nn.Parameter(torch.zeros(self.D))  # ℝ[D]

    def forward(self, x, eps=1e-5):
        """Generated from `fn apply` (layernorm.psk:13)."""
        # x : ℝ[..., model: D]
        # eps : f64
        μ = x.mean(dim=-1)  # ℝ[...]
        σ2 = ((x - μ.unsqueeze(-1)) ** 2).mean(dim=-1)  # ℝ[...]
        x̂ = (x - μ.unsqueeze(-1)) / torch.sqrt((σ2 + eps)).unsqueeze(-1)  # ℝ[..., model: D]
        return x̂ * self.γ + self.β

class RMSNorm(nn.Module):
    """Generated from `module RMSNorm` (layernorm.psk:21). Do not edit by hand."""

    def __init__(self, D):
        super().__init__()
        self.D = D
        self.γ = nn.Parameter(torch.ones(self.D))  # ℝ[D]

    def forward(self, x, eps=1e-6):
        """Generated from `fn apply` (layernorm.psk:24)."""
        # x : ℝ[..., model: D]
        # eps : f64
        ms = (x ** 2).mean(dim=-1)  # ℝ[...]
        return x / torch.sqrt((ms + eps)).unsqueeze(-1) * self.γ
