fn mse_grad.lambda0{D B}(x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D], θ : params MLP{D, 4*D}) -> ℝ[] {
  %3 : ℝ[] = call mse{D = D, B = B}(θ, x, y)
  return %3
}

fn mse_grad.lambda0.vjp{D B}(x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D], θ : params MLP{D, 4*D}, ct : ℝ[]) -> (params MLP{D, 4*D}) {
  %4 : (((ℝ[batch: B, D], ℝ[batch: B, model: D], (ℝ[batch: B, 4*D], ℝ[batch: B, 4*D])))) = call mse_grad.lambda0.fwd{D = D, B = B}(x, y, θ)
