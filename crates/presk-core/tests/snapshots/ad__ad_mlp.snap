fn mse.vjp{D B}(θ : params MLP{D, 4*D}, x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D], ct : ℝ[]) -> (params MLP{D, 4*D}) {
  %4 : ((ℝ[batch: B, D], ℝ[batch: B, model: D], (ℝ[batch: B, 4*D], ℝ[batch: B, 4*D]))) = call mse.fwd{D = D, B = B}(θ, x, y)
