// lo, hi: the range of i0 in 0..2, the outermost loop, which a thread split divides
static void f64_k0(const double *restrict in0, const double *restrict in1, double *restrict out, int64_t lo, int64_t hi) {
    int64_t i0 = 0, i1 = 0, i2 = 0;
    double s0 = 0.0;
    double v0[2] = {0}, v1[2] = {0}, v2[2] = {0}, v3[2] = {0};
    for (i0 = lo; i0 < hi; i0++) {
        for (i1 = 0; i1 < 1; i1++) {
            for (int l = 0; l < 2; l++) v0[l] = 0.0;
            for (int l = 0; l < 2; l++) v1[l] = 0.0;
            for (int l = 0; l < 2; l++) v2[l] = 0.0;
            for (int l = 0; l < 2; l++) v3[l] = 0.0;
            for (i2 = 0; i2 < 4; i2++) {
                s0 = in0[i0 * 4 + i2];
                for (int l = 0; l < 2; l++) v0[l] = v0[l] + s0 * in1[i2 * 8 + i1 * 8 + l];
                for (int l = 0; l < 2; l++) v1[l] = v1[l] + s0 * in1[i2 * 8 + i1 * 8 + 2 + l];
                for (int l = 0; l < 2; l++) v2[l] = v2[l] + s0 * in1[i2 * 8 + i1 * 8 + 4 + l];
                for (int l = 0; l < 2; l++) v3[l] = v3[l] + s0 * in1[i2 * 8 + i1 * 8 + 6 + l];
            }
            for (int l = 0; l < 2; l++) out[i0 * 8 + i1 * 8 + l] = v0[l];
            for (int l = 0; l < 2; l++) out[i0 * 8 + i1 * 8 + 2 + l] = v1[l];
            for (int l = 0; l < 2; l++) out[i0 * 8 + i1 * 8 + 4 + l] = v2[l];
            for (int l = 0; l < 2; l++) out[i0 * 8 + i1 * 8 + 6 + l] = v3[l];
        }
    }
}

