// lo, hi: the range of i0 in 0..2, the outermost loop, which a thread split divides
static void f64_k1(const double *restrict in0, const double *restrict in1, double *restrict out, int64_t lo, int64_t hi) {
    int64_t i0 = 0, i1 = 0;
    for (i0 = lo; i0 < hi; i0++) {
        for (i1 = 0; i1 < 8; i1++) {
            out[i0 * 8 + i1] = in0[i0 * 8 + i1] + in1[i1];
        }
    }
}

