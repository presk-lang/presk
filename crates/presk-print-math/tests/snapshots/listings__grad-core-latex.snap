% presk dump --stage core-after-ad --format latex: 04_grad.psk, PSK-Core after differentiation,
% one equation per binding, in the notation of the language reference's chapter 3.

\paragraph{Function $\code{Linear.apply}$.} Of $\theta : \code{params}\ \code{Linear\{In, Out\}}$, $x : \mathbb{R}[\ldots, \mathit{In}]$, dimensions $\mathit{In}$, $\mathit{Out}$.
\begin{alignat*}{2}
w &= \theta.w \\
\%3 &= \code{dot}\ x, w \\
b &= \theta.b \\
\%5 &= \%3 + b \\
\den{\code{Linear.apply}}(\theta, x) &= \%5
\end{alignat*}

\paragraph{Function $\code{loss}$.} Of $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\hat{y} &= \den{\code{Linear.apply}\{\mathit{In} = D, \mathit{Out} = 1\}}(\theta, x) \\
\%4 &= \hat{y} - y \\
\%5 &= \%4^{2} \\
\%6 &= \code{mean}\ \%5 \\
\den{\code{loss}}(\theta, x, y) &= \%6
\end{alignat*}

\paragraph{Function $\code{loss\_grad}$.} Of $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%3 &= v \mapsto \den{\code{loss\_grad.lambda0}}(x, y, v) \\
\%4 &= v \mapsto \den{\code{loss\_grad.lambda0.grad}}(x, y, v) \\
\%5 &= \%4(\theta) \\
\den{\code{loss\_grad}}(\theta, x, y) &= \%5
\end{alignat*}

\paragraph{Function $\code{Linear.init}$.} Of $\mathit{key} : \code{key}$, dimensions $\mathit{In}$, $\mathit{Out}$, uses Rand.
\begin{alignat*}{2}
\%1 &= \code{split\_key}\ 2\ \mathit{key} \\
\%2 &= \%1.0 \\
\%3 &= \%1.1 \\
w &= \code{xavier\_uniform}\ \%2 \\
b &= \code{zeros} \\
\%6 &= \{w = w, b = b\} \\
\den{\code{Linear.init}}(\mathit{key}) &= \%6
\end{alignat*}

\paragraph{Function $\code{loss\_grad.lambda0}$.} Of $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, $\theta : \code{params}\ \code{Linear\{D, 1\}}$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%3 &= \den{\code{loss}\{D = D, B = B\}}(\theta, x, y) \\
\den{\code{loss\_grad.lambda0}}(x, y, \theta) &= \%3
\end{alignat*}

\paragraph{Function $\code{loss\_grad.lambda0.vjp}$.} Generated by differentiation (\texttt{vjp}) from $\code{loss\_grad.lambda0}$. Of $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $\mathit{ct} : \mathbb{R}[]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%4 &= \den{\code{loss\_grad.lambda0.fwd}\{D = D, B = B\}}(x, y, \theta) \\
\%5 &= \%4.0 \\
\%6 &= \den{\code{loss\_grad.lambda0.bwd}\{D = D, B = B\}}(x, \theta, \%5, \mathit{ct}) \\
\den{\code{loss\_grad.lambda0.vjp}}(x, y, \theta, \mathit{ct}) &= \%6
\end{alignat*}

\paragraph{Function $\code{loss.vjp}$.} Generated by differentiation (\texttt{vjp}) from $\code{loss}$. Of $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, $\mathit{ct} : \mathbb{R}[]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%4 &= \den{\code{loss.fwd}\{D = D, B = B\}}(\theta, x, y) \\
\%5 &= \%4.0 \\
\%6 &= \den{\code{loss.bwd}\{D = D, B = B\}}(\theta, x, \%5, \mathit{ct}) \\
\den{\code{loss.vjp}}(\theta, x, y, \mathit{ct}) &= \%6
\end{alignat*}

\paragraph{Function $\code{Linear.apply.vjp}$.} Generated by differentiation (\texttt{vjp}) from $\code{Linear.apply}$. Of $\theta : \code{params}\ \code{Linear\{In, Out\}}$, $x : \mathbb{R}[\ldots, \mathit{In}]$, $\mathit{ct} : \mathbb{R}[\ldots, \mathit{Out}]$, dimensions $\mathit{In}$, $\mathit{Out}$.
\begin{alignat*}{2}
\%3 &= \den{\code{Linear.apply.bwd}\{\mathit{In} = \mathit{In}, \mathit{Out} = \mathit{Out}\}}(\theta, x, \mathit{ct}) \\
\den{\code{Linear.apply.vjp}}(\theta, x, \mathit{ct}) &= \%3
\end{alignat*}

\paragraph{Function $\code{loss\_grad.lambda0.grad}$.} Generated by differentiation (\texttt{grad}) from $\code{loss\_grad.lambda0}$. Of $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, $\theta : \code{params}\ \code{Linear\{D, 1\}}$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%3 &= 1 &\qquad& \text{\footnotesize the cotangent 1} \\
\%4 &= \%3 &\qquad& \text{\footnotesize the cotangent 1} \\
\%5 &= \den{\code{loss\_grad.lambda0.vjp}\{D = D, B = B\}}(x, y, \theta, \%4) \\
\%6 &= \%5.0 \\
\den{\code{loss\_grad.lambda0.grad}}(x, y, \theta) &= \%6
\end{alignat*}

\paragraph{Function $\code{Linear.apply.bwd}$.} Generated by differentiation (\texttt{bwd}) from $\code{Linear.apply}$. Of $\theta : \code{params}\ \code{Linear\{In, Out\}}$, $x : \mathbb{R}[\ldots, \mathit{In}]$, $\mathit{ct} : \mathbb{R}[\ldots, \mathit{Out}]$, dimensions $\mathit{In}$, $\mathit{Out}$.
\begin{alignat*}{2}
b &= \theta.b &\qquad& \text{\footnotesize primal $b$, kept} \\
\%8 &= \code{sum\_to}\ \mathit{ct}, b &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{add})} \\
\%9 &= \code{zeros\_like}\ \theta &\qquad& \text{\footnotesize adjoint of $b$ (\texttt{field})} \\
\%10 &= \code{set\_field}\ \code{b}\ \%9, \%8 &\qquad& \text{\footnotesize adjoint of $b$ (\texttt{field})} \\
\%12 &= \code{dot\_vjp\_r}\ x, \mathit{ct} &\qquad& \text{\footnotesize adjoint of $\%3$ (\texttt{dot})} \\
\%13 &= \code{zeros\_like}\ \theta &\qquad& \text{\footnotesize adjoint of $w$ (\texttt{field})} \\
\%14 &= \code{set\_field}\ \code{w}\ \%13, \%12 &\qquad& \text{\footnotesize adjoint of $w$ (\texttt{field})} \\
\%15 &= \%10 + \%14 &\qquad& \text{\footnotesize accumulates the adjoint of a parameter of \texttt{Linear.apply}} \\
\%16 &= (\%15) \\
\den{\code{Linear.apply.bwd}}(\theta, x, \mathit{ct}) &= \%16
\end{alignat*}

\paragraph{Function $\code{loss.bwd}$.} Generated by differentiation (\texttt{bwd}) from $\code{loss}$. Of $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $\mathit{residuals} : (\mathbb{R}[\code{batch}{:}\,B, 1], \mathbb{R}[\code{batch}{:}\,B, 1])$, $\mathit{ct} : \mathbb{R}[]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\%5 &= \mathit{residuals}.0 &\qquad& \text{\footnotesize primal $\%4$, kept} \\
\%6 &= \mathit{residuals}.1 &\qquad& \text{\footnotesize primal $\%5$, kept} \\
\%8 &= \code{mean\_vjp}\ \mathit{ct}, \%6 &\qquad& \text{\footnotesize adjoint of $\%6$ (\texttt{mean})} \\
\%9 &= 2 &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{pow})} \\
\%10 &= \%9 &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{pow})} \\
\%11 &= \%5^{1} &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{pow})} \\
\%12 &= \%10 \times \%11 &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{pow})} \\
\%13 &= \%8 \times \%12 &\qquad& \text{\footnotesize adjoint of $\%5$ (\texttt{pow})} \\
\%17 &= \den{\code{Linear.apply.bwd}\{\mathit{In} = D, \mathit{Out} = 1\}}(\theta, x, \%13) &\qquad& \text{\footnotesize adjoint of $\hat{y}$ (\texttt{call})} \\
\%18 &= \%17.0 &\qquad& \text{\footnotesize adjoint of $\hat{y}$ (\texttt{call})} \\
\%20 &= (\%18) \\
\den{\code{loss.bwd}}(\theta, x, \mathit{residuals}, \mathit{ct}) &= \%20
\end{alignat*}

\paragraph{Function $\code{loss.fwd}$.} Generated by differentiation (\texttt{fwd}) from $\code{loss}$. Of $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, dimensions $D$, $B$.
\begin{alignat*}{2}
\hat{y} &= \den{\code{Linear.apply}\{\mathit{In} = D, \mathit{Out} = 1\}}(\theta, x) &\qquad& \text{\footnotesize primal $\hat{y}$, stored} \\
\%4 &= \hat{y} - y &\qquad& \text{\footnotesize primal $\%4$, stored} \\
\%5 &= \%4^{2} &\qquad& \text{\footnotesize primal $\%5$, stored} \\
\%7 &= (\%4, \%5) \\
\%8 &= (\%7) \\
\den{\code{loss.fwd}}(\theta, x, y) &= \%8
\end{alignat*}

\paragraph{Function $\code{loss\_grad.lambda0.bwd}$.} Generated by differentiation (\texttt{bwd}) from $\code{loss\_grad.lambda0}$. Of $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $\theta : \code{params}\ \code{Linear\{D, 1\}}$, $\mathit{residuals} : ((\mathbb{R}[\code{batch}{:}\,B, 1], \mathbb{R}[\code{batch}{:}\,B, 1]))$, $\mathit{ct} : \mathbb{R}[]$, dimensions $D$, $B$.
\begin{alignat*}{2}
