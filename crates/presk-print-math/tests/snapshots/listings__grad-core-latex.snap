\%5 &= \den{\code{loss.bwd}\{D = D, B = B\}}(\theta, x, \%10, \mathit{ct}) &\qquad& \text{\footnotesize adjoint of $\%3$ (\texttt{call})} \\
\%6 &= \%5.0 &\qquad& \text{\footnotesize adjoint of $\%3$ (\texttt{call})} \\
\%9 &= (\%6) \\
\den{\code{loss\_grad.lambda0.bwd}}(x, \theta, \mathit{residuals}, \mathit{ct}) &= \%9
\end{alignat*}

\paragraph{Function $\code{loss\_grad.lambda0.fwd}$.} Generated by differentiation (\texttt{fwd}) from $\code{loss\_grad.lambda0}$. Of $x : \mathbb{R}[\code{batch}{:}\,B, D]$, $y : \mathbb{R}[\code{batch}{:}\,B, 1]$, $\theta : \code{params}\ \code{Linear\{D, 1\}}$, dimensions $D$, $B$.
