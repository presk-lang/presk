-- 05_gpt.psk — the GPT of the NLP course, character-level, on the Code civil.
--
-- The course builds this model in `notebooks/007_gpt` (Karpathy's "let's build
-- GPT"): a pre-normalized decoder-only transformer over the characters of the
-- Code civil. The constants below are the course's; `--const` shrinks them to
-- a size this compiler can carry today, which is the point of the rung — it is
-- the forcing function of version 0.4.0, not a demonstration.
const V  : nat = 92        -- characters of data/civil_vocab.json
const D  : nat = 384       -- model width
const H  : nat = 6         -- attention heads
const HD : nat = D / H
const L  : nat = 6         -- blocks
static assert D % H == 0

dim B
dim T <= 1024

type Tokens = idx[V][batch: B, seq: T]
type Acts   = ℝ[batch: B, seq: T, model: D]
type Mask   = ℝ[seq: T, seq2: T]

-- The accumulator of the block stack. A fold hands every iteration the same
-- extras, so a key passed as an extra would be one key for all L blocks and
-- every layer would drop the same positions; carried in the accumulator it is
-- threaded, and each block draws its own (0.5.0 step 1, question 51).
type Acc    = (Acts, key)

module Linear{In Out : dim} {
  param w : ℝ[In, Out]  init = xavier_uniform
  param b : ℝ[Out]      init = zeros
  fn apply(x : ℝ[..., In]) -> ℝ[..., Out] = x · w + b
}

module LayerNorm{Dm : dim} {
  param γ : ℝ[Dm]  init = ones
  param β : ℝ[Dm]  init = zeros

  fn apply(x : ℝ[..., model: Dm]) -> ℝ[..., model: Dm] =
    let μ  = mean(axis model, x)
    let σ2 = mean(axis model, (x - μ)^2)
    (x - μ) / sqrt(σ2 + real(1e-5)) * γ + β
}

module SelfAttention {
  use wq, wk, wv, wo : Linear{D, D}

  fn apply(x : Acts, mask : Mask, kd : key) -> Acts uses Rand =
    let q = split_heads(wq.apply(x))
    let k = split_heads(wk.apply(x))
    let v = split_heads(wv.apply(x))
    let s = ein[batch, heads, seq, seq2](q * k) / sqrt(HD : ℝ)
    let a = dropout(0.2, kd, softmax(axis seq2, s + mask))
    wo.apply(merge_heads(ein[batch, heads, seq, hd](a * v)))
}

module FeedForward {
  use up   : Linear{D, 4*D}
  use down : Linear{4*D, D}
  fn apply(x : Acts) -> Acts = down.apply(gelu(up.apply(x)))
}

module Block {
  use attn : SelfAttention
  use ff   : FeedForward
  use ln1, ln2 : LayerNorm{D}

  -- Three dropouts a block at the course's rate of 0.2, where it has them:
  -- on the attention weights, on the attention output and on the
  -- feed-forward output. The rate is written at each site because `const`
  -- holds naturals only (E1009).
  fn apply(s : Acc, mask : Mask) -> Acc uses Rand =
    let (x, k)     = s
    let (katt, k1) = split_key(k)
    let (kres, k2) = split_key(k1)
    let (kff,  k3) = split_key(k2)
    let h = x + dropout(0.2, kres, attn.apply(ln1.apply(x), mask, katt))
    (h + dropout(0.2, kff, ff.apply(ln2.apply(h))), k3)
}

module GPT {
  param tok : ℝ[vocab: V, model: D]  init = normal(std = 0.02)
  param pos : ℝ[T, D]                init = normal(std = 0.02)
  use blocks : stack{L}(Block)
  use lnf    : LayerNorm{D}
  param head : ℝ[D, V]               init = zeros

  fn apply(ids : Tokens, k : key) -> ℝ[batch: B, seq: T, vocab: V] uses Rand =
    let mask     = causal_mask(seq: T)
    let h0       = embed(tok, ids) + embed(pos, positions(seq: T))
    let (ke, kb) = split_key(k)
    let (hL, _)  = blocks.apply((dropout(0.2, ke, h0), kb), mask)
    lnf.apply(hL) · head
}

-- The objective takes a per-step key between θ and the batch, which the
-- training loop derives from the run's seed (D29).
fn loss(θ : params GPT, k : key, batch : (Tokens, Tokens)) -> ℝ[] uses Rand =
  let (x, y) = batch
  mean(cross_entropy(GPT.apply(θ, x, k), y))

-- Next-character accuracy: the fraction of positions whose most likely
-- character is the one that follows, the kind of task metric MLPerf's
-- accuracy rule thresholds (0.6.0 step 8). An evaluation, not an objective:
-- `argmax` is discontinuous. `hits` names the axis `one_hot` leaves unnamed.
fn hits(p : ℝ[batch: B, seq: T, vocab: V], q : ℝ[batch: B, seq: T, vocab: V]) -> ℝ[batch: B, seq: T] =
  sum(axis vocab, p * q)

fn accuracy(θ : params GPT, k : key, batch : (Tokens, Tokens)) -> ℝ[] uses Rand =
  let (x, y) = batch
  mean(hits(one_hot(argmax(GPT.apply(θ, x, k))), one_hot(y)))

optimizer adamw {
  lr           : f64 = 3e-4
  betas        : (f64, f64) = (0.9, 0.95)
  weight_decay : f64 = 0.1
  grad_clip    : f64 = 1.0
  schedule     : cosine(warmup = 100)
}

training run {
  model     = GPT
  objective = loss
  optimizer = adamw
  data      = stream "data/civil_T256.psk.d" |> shuffle(seed = 7) |> batch(B = 16)
  epochs    : nat = 1
  checkpoint every 500 steps to "ckpt/"
}
