-- llama.psk — the decoder MLPerf uses for Llama 2 70B (LoRA fine-tuning) and
-- that GPT-J and Mixtral share the shape of, at the 7B configuration so the
-- constants stay readable. Transcribed to see what the shape fragment covers.
--
-- One departure from the real model, marked below. 0.4.0 recorded two, both
-- blocked on splitting one axis into two; 0.5.0 step 1 added `split`, and
-- grouped-query attention is now transcribed exactly. Rotary positions are
-- not, and the split was not what they were missing: see the note above
-- `Llama` for what they need instead.
const V  : nat = 32000
const D  : nat = 4096
const H  : nat = 32
const HD : nat = D / H
const G  : nat = 8         -- key/value heads: 32 query heads in 8 groups
const P  : nat = H / G     -- query heads per group
const FF : nat = 11008     -- SwiGLU's hidden width, not 4·D
const L  : nat = 32
static assert D % H == 0
static assert H % G == 0

dim B
dim T <= 4096

type Tokens = idx[V][batch: B, seq: T]
type Acts   = ℝ[batch: B, seq: T, model: D]
type Mask   = bool[seq: T, seq2: T]

-- Llama's projections carry no bias.
module Dense{In Out : dim} {
  param w : ℝ[In, Out]  init = normal(std = 0.02)
  fn apply(x : ℝ[..., In]) -> ℝ[..., Out] = x · w
}

module RMSNorm{Dm : dim} {
  param γ : ℝ[Dm]  init = ones
  fn apply(x : ℝ[..., model: Dm]) -> ℝ[..., model: Dm] =
    let ms = mean(axis model, x * x)
    x / sqrt(ms + real(1e-5)) * γ
}

-- SiLU, the activation of SwiGLU: x·σ(x). Expressible from `sigmoid`.
fn silu(x : ℝ[...]) -> ℝ[...] = x * sigmoid(x)

module SwiGLU {
  use gate : Dense{D, FF}
  use up   : Dense{D, FF}
  use down : Dense{FF, D}
  fn apply(x : Acts) -> Acts = down.apply(silu(gate.apply(x)) * up.apply(x))
}

-- Grouped-query attention, exactly as Llama 2 70B has it: 32 query heads
-- share 8 key/value heads, so the keys and values project to G·HD channels
-- rather than D and one key head serves P = 4 query heads.
--
-- Nothing here transposes, and that is the point. `split` reads one axis as
-- two and `ein` contracts *by name*, so the group axis of the queries meets
-- the group axis of the keys wherever each happens to sit. This is why the
-- split finishes the family while `split_heads` could not: that primitive is
-- hard-wired to `const H` and `const HD` and also permutes, so it cannot say
-- "eight heads shared by thirty-two" at all (D28).
module Attention {
  -- Written as plain parameters rather than through `Dense` so that each
  -- projection's output axis has a name the split can select. Llama's
  -- projections are biasless linear maps, so `x · w` is the whole of them.
  param wq : ℝ[model: D, qout: D]       init = normal(std = 0.02)
  param wk : ℝ[model: D, kvout: G*HD]   init = normal(std = 0.02)
  param wv : ℝ[model: D, kvout: G*HD]   init = normal(std = 0.02)
  param wo : ℝ[headhd: D, model: D]     init = normal(std = 0.02)

  fn apply(x : Acts, mask : Mask) -> Acts =
    -- The queries keep all D channels and are read as (groups, per, hd); the
    -- keys and values have only G·HD and are read as (groups, hd), so one key
    -- head faces the P query heads of its group.
    let qg = split(axis qout, groups: G, rest: P*HD, x · wq)
    let q  = split(axis rest, per: P, hd: HD, qg)
    let k  = split(axis kvout, groups: G, hd: HD, x · wk)
    let v  = split(axis kvout, groups: G, hd: HD, x · wv)
    let s  = ein[batch, groups, per, seq, seq2](q * k) / sqrt(HD : ℝ)
    let a  = softmax(axis seq2, s, where = mask)
    let o  = ein[batch, seq, groups, per, hd](a * v)
    -- The output projection reads `wo` under the same three axes instead of
    -- flattening `o` back: `merge` leaves the joined axis unnamed (D28), so
    -- two merges cannot be chained, while two splits can.
    let w1 = split(axis headhd, groups: G, rest: P*HD, wo)
    let w2 = split(axis rest, per: P, hd: HD, w1)
    ein[batch, seq, model](o * w2)
}

module Block {
  use attn : Attention
  use ff   : SwiGLU
  use n1, n2 : RMSNorm{D}
  fn apply(x : Acts, mask : Mask) -> Acts =
    let x = x + attn.apply(n1.apply(x), mask)
    x + ff.apply(n2.apply(x))
}

-- The real model has no learned position table: it rotates queries and keys
-- by an angle that depends on the position (RoPE). `split` now gives the
-- pairing it needs — `split(axis hd, rot: HD/2, pair: 2, q)` checks — but
-- the pairing was never the hard part. The rotation reads both members of a
-- pair and writes both back:
--
--     out[…, r, 0] = x[…, r, 0]·cos θ − x[…, r, 1]·sin θ
--     out[…, r, 1] = x[…, r, 0]·sin θ + x[…, r, 1]·cos θ
--
-- Reading them is `x[pair: 0]` and `x[pair: 1]`, which this language has.
-- Writing them back is building a tensor along an axis out of two computed
-- parts, which it does not: `concat` is declared and not implemented, and
-- there is no array literal, so the rotation cannot be assembled. So this
-- transcription keeps a learned table, and what it is waiting for is not a
-- shape construct but a way to *make* a tensor from values.
module Llama {
  param tok : ℝ[vocab: V, model: D]  init = normal(std = 0.02)
  param pos : ℝ[T, D]                init = normal(std = 0.02)
  use blocks : stack{L}(Block)
  use norm   : RMSNorm{D}
  -- Initialized as the other matrices, as Hugging Face's LlamaPreTrainedModel
  -- initializes every linear map (`initializer_range` 0.02). Until D104 it was
  -- `zeros`, which makes every logit zero at initialization: the gap of a
  -- realization to the exact logits is then relative to max|y| = 0, and
  -- `presk solve` has no sensitivity to rank sites by.
  param head : ℝ[D, V]               init = normal(std = 0.02)

  fn apply(ids : Tokens) -> ℝ[batch: B, seq: T, vocab: V] =
    let mask = causal_mask(seq: T)
    let h = embed(tok, ids) + embed(pos, positions(seq: T))
    norm.apply(blocks.apply(h, mask)) · head
}

-- The next-token loss, as corpus/nlp/05_gpt.psk writes its own without the
-- key (this model draws nothing): the mean cross-entropy of the logits at
-- each position against the token that follows it, given as `y`. A scalar,
-- which `presk solve` needs to rank its sites (D101); D104 measures it.
fn loss(θ : params Llama, batch : (Tokens, Tokens)) -> ℝ[] =
  let (x, y) = batch
  mean(cross_entropy(Llama.apply(θ, x), y))
