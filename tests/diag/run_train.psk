-- E7003: `presk train` refuses a training run whose objective is undefined
-- at its dimensions: with `K = 0`, the model averages over an axis of
-- length 0, before a step is taken.
--   presk train tests/diag/run_train.psk --const K=0 --steps 1 --ckpt $OUT/ckpt
const K : nat = 3
dim B

module Reg {
  param w : ℝ[2, hidden: K]
  fn apply(x : ℝ[batch: B, 2]) -> ℝ[batch: B] = mean(axis hidden, x · w)
}

fn loss(θ : params Reg, batch : (ℝ[batch: B, 2], ℝ[batch: B, 1])) -> ℝ[] =
  let (x, y) = batch
  mean((Reg.apply(θ, x) - mean(y))^2)

optimizer adamw {
  lr : f64 = 0.05
}

training run {
  model     = Reg
  objective = loss
  optimizer = adamw
  data      = stream "../train/reg.psk.d" |> batch(B = 16)
  epochs    : nat = 1
}
