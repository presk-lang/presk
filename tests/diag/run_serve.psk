-- E7003: `presk serve` refuses a call of the generation function at a
-- context undefined for it: the first context of a one-token prompt has
-- `T = 1`, and the function selects the position before the last. The
-- weights are those the C export writes for a defined call.
-- setup: presk export tests/diag/run_serve.psk --target c --entry next --dim B=1 --dim T=2 -o $OUT/w
--   presk serve tests/diag/run_serve.psk --weights $OUT/w/conformance/weights.psk.d --prompt 1 --tokens 2 --temperature 0
const V : nat = 4
dim B
dim T

module Toy {
  param w : ℝ[V, V]
  fn apply(x : idx[V][batch: B, seq: T]) -> ℝ[batch: B, seq: T, vocab: V] = embed(w, x)
}

fn next(θ : params Toy, ctx : idx[V][batch: B, seq: T]) -> idx[V][batch: B] =
  argmax(Toy.apply(θ, ctx)[seq: -2])

inference serve {
  model   = Toy
  weights = "ckpt/final"
}
