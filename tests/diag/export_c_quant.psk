-- E8007: integer weights where the C program cannot follow them. A
-- realization that quantizes `w` (int8 or int4) makes it integers and a
-- scale per channel; the C export reads them, slices them and hands them to
-- the kernels (plan 0.9.0 step 7), and refuses them in the entry's result,
-- which the program writes as reals it computes, and under a reshape, which
-- keeps the scales' axis while the shape moves under it.
--   presk export tests/diag/export_c_quant.psk --target c --entry L.flat --realize @Q.json -o DIR
module L {
  param w : ℝ[r: 4, c: 6] init = xavier_uniform
  fn same(x : ℝ[4]) -> ℝ[r: 4, c: 6] = w
  fn flat(x : ℝ[24]) -> ℝ[] = sum(merge(axis r, axis c, w) * x)
}
