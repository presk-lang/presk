-- A fold whose value a function returns as it is, for the C export's
-- structured host (plan 0.9.0 step 4): the value is left in the loop's
-- alternating buffers, and copied into the buffer the caller gave for the
-- function's result. `Norms.apply` returns it to the entry's caller,
-- `scaled` through a call.
import "../examples/layernorm/layernorm.psk" as norm

dim B
const L : nat = 3

module Norms {
  use ln : stack{L}(norm.LayerNorm{8})

  fn apply(x : ℝ[batch: B, model: 8]) -> ℝ[batch: B, model: 8] = ln.apply(x)
}

fn scaled(θ : params Norms, x : ℝ[batch: B, model: 8]) -> ℝ[batch: B, model: 8] =
  Norms.apply(θ, x) * real(2.0)
