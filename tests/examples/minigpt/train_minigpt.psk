-- train_minigpt.psk — Declarative training of MiniGPT (§6).
-- Illustrates: cross_entropy objective on idx[V] targets, optimizer, training run,
-- precision budget (a constraint, not a dtype), declarative parallelism.
import "minigpt.psk" as m

-- ── Objective ────────────────────────────────────────────────────────────────────
-- The batch is made of INDICES (idx[V]), not reals: x = input tokens,
-- y = target tokens shifted by one. cross_entropy is differentiable in the logits
-- (gather of log-softmax, stabilized at compile time), Disc in y (§3.5).
fn loss(θ : params m.MiniGPT,
        batch : (idx[m.V][batch: B, seq: T], idx[m.V][batch: B, seq: T])) -> ℝ[] =
  let (x, y) = batch
  let logits = m.MiniGPT.apply(θ, x)          -- ℝ[batch, seq, vocab: V]
  mean(cross_entropy(logits, y))              -- mean over batch × seq

-- ── Optimizer ────────────────────────────────────────────────────────────────────
-- Hyperparameters are machine types (f64, nat…), evaluated at launch.
-- The update is a pure function (θ, state, grad) → (θ', state') (§6).
optimizer adamw {
  lr           : f64 = 3e-4
  betas        : (f64, f64) = (0.9, 0.95)
  weight_decay : f64 = 0.1
  grad_clip    : f64 = 1.0
  schedule     : cosine(warmup = 2000)
}

-- ── Training loop (a language construct) ─────────────────────────────────────────
training run {
  model     = m.MiniGPT
  objective = loss
  optimizer = adamw

  -- Data pipeline: the stream carries idx[V], not reals.
  data      = stream "data/tokens.psk.d" |> shuffle(seed = 1234) |> batch(B = 32)
  epochs    : nat = 10

  -- Declarative parallelism: the compiler inserts the collectives (all-reduce,
  -- all-gather) and PROVES that the distributed program denotes the same function (§6).
  parallel  = data_parallel(replicas = auto) ⊗ tensor_parallel(axis model)

  -- The budget is an error CONSTRAINT, not a dtype. PSK-Sched chooses representations
  -- (BF16 activations, FP32 accumulations…) under it, discharged by measurement (§6.1, §8.3).
  precision = budget(rel_error = 1e-3)

  -- checkpoint: a memory annotation with no semantic effect (§5).
  checkpoint every 1000 steps to "ckpt/"
}
