-- serve_minigpt.psk — Inference and generation (§7).
-- Illustrates: inference serve, quantization under a budget, kv_cache as a CERTIFIED
-- graph transformation, and sampling under the Rand effect.
import "minigpt.psk" as m

-- ── Sampling one token ───────────────────────────────────────────────────────────
-- argmax and sample return an idx[V] (class Disc). sample carries the Rand effect and takes
-- no key yet: the compiler draws it from a stream seeded by the run's seed (§2.2, §10).
fn next_token(θ : params m.MiniGPT, ctx : idx[m.V][batch: B, seq: T],
              temperature : f64 = 0.8) -> idx[m.V][batch: B] uses Rand =
  let logits = m.MiniGPT.apply(θ, ctx)            -- ℝ[batch, seq, vocab: V]
  let last   = logits[seq: -1]                    -- ℝ[batch, vocab: V]: last position
  sample(last / real(temperature))               -- idx[V] per batch element

-- ── Serving configuration ────────────────────────────────────────────────────────
inference serve {
  model   = m.MiniGPT
  weights = "ckpt/final"

  -- Absolute error budget, THEN calibrated int8 quantization. The budget is discharged by
  -- measurement (§8.3); int8 is a representation choice, not a rewrite of the model (§7).
  precision = budget(abs_error = 1e-2) | quantize(int8, calibration = "data/calib.psk.d")

  -- Alternative targets; the same source serves both through distinct backends (§8).
  target    = gpu(sm_90) | cpu(avx512)

  batching  = dynamic(max_batch = 64, timeout = 5ms)

  -- kv_cache: a VERIFIED program transformation. The graph with cache denotes the same
  -- function as without cache, under the causality hypothesis carried by the mask's type
  -- (causal_mask in minigpt.psk) — not a manual hack (§7).
  cache     = kv_cache(axis seq)
}
