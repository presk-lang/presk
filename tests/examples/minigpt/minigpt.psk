-- minigpt.psk — A decoder-only GPT, complete and typed.
-- Illustrates: idx[V] for tokens, embeddings as a one-hot contraction (§3.5),
-- causal attention through typed ein[…], Transformer blocks, stack{N}, output head.
--
-- Depends on: ../layernorm/layernorm.psk (LayerNorm), ../mlp/mlp.psk (Linear).
import "../layernorm/layernorm.psk"  as norm
import "../mlp/mlp.psk"              as ff

-- ── Hyperparameters (outside the graph: evaluated statically, cf. §1) ────────────
const V  : nat = 50257     -- vocabulary size
const D  : nat = 768       -- model dimension
const H  : nat = 12        -- number of heads
const HD : nat = D / H     -- dimension per head
const L  : nat = 12        -- number of blocks
static assert D % H == 0   -- decidable Presburger fragment (§3.1)

-- ── Symbolic dimensions (resolved at use) ────────────────────────────────────────
dim B                       -- batch size
dim T <= 1024               -- context length, bounded

-- ── Named types, to avoid "index soup" (§3.2) ────────────────────────────────────
type Tokens = idx[V][batch: B, seq: T]                 -- input: indices, NOT reals
type Acts   = ℝ[batch: B, seq: T, model: D]            -- activations
type Mask   = ℝ[seq: T, seq2: T]                       -- additive mask (0 or −∞)

-- ─────────────────────────────────────────────────────────────────────────────────
-- Causal multi-head attention.
-- ─────────────────────────────────────────────────────────────────────────────────
module SelfAttention {
  use wq, wk, wv, wo : ff.Linear{D, D}

  -- split_heads : ℝ[batch, seq, model: D] -> ℝ[batch, heads: H, seq, hd: HD]
  -- merge_heads : the inverse. Provided by the standard library; pure axis reshuffles.
  fn apply(x : Acts, mask : Mask) -> Acts =
    let q = split_heads(wq.apply(x))
    let k = split_heads(wk.apply(x))
    let v = split_heads(wv.apply(x))

    -- Typed contraction: the `hd` axis is reduced, `seq`×`seq2` yields the score matrix.
    -- The compiler checks that `hd` appears in exactly the two operands (§3.2).
    let s = ein[batch, heads, seq, seq2](q * k) / sqrt(HD : ℝ)

    -- softmax over seq2, causal mask added before normalization.
    let a = softmax(axis seq2, s + mask)

    -- Reweighting of the values, then output projection.
    let o = ein[batch, heads, seq, hd](a * v)
    wo.apply(merge_heads(o))
    -- Note: no trace of FlashAttention here. The softmax+matmul fusion is a
    -- scheduling strategy chosen by PSK-Realize (§8.2), not a hand-written kernel.
}

-- ─────────────────────────────────────────────────────────────────────────────────
-- Pre-normalized Transformer block (Pre-LN), with residual connections.
-- ─────────────────────────────────────────────────────────────────────────────────
module Block {
  use attn : SelfAttention
  use mlp  : ff.MLP{D, 4*D}
  use ln1, ln2 : norm.LayerNorm{D}

  fn apply(x : Acts, mask : Mask) -> Acts =
    let x = x + attn.apply(ln1.apply(x), mask)   -- shadowing: new binding, no mutation
    x + mlp.apply(ln2.apply(x))
}

-- ─────────────────────────────────────────────────────────────────────────────────
-- Token and position embeddings.
-- embed denotes eₜᵀ·W (one-hot × table); compiled to a gather, never materialized (§3.5).
-- ─────────────────────────────────────────────────────────────────────────────────
module Embedding {
  param tok : param ℝ[V, D]  init = normal(std = 0.02)   -- token table
  param pos : param ℝ[T, D]  init = normal(std = 0.02)   -- learned position table

  fn apply(ids : Tokens) -> Acts =
    let e = embed(tok, ids)                 -- ℝ[batch, seq, model: D]; grad = scatter-add on tok
    let p = embed(pos, positions(seq: T))   -- positions(): idx[T] along the seq axis
    e + p                                    -- broadcast of p over the batch
}

-- ─────────────────────────────────────────────────────────────────────────────────
-- The complete model: embeddings → L stacked blocks → final norm → logits.
-- ─────────────────────────────────────────────────────────────────────────────────
module MiniGPT {
  use emb    : Embedding
  use blocks : stack{L}(Block)     -- params stacked as ℝ[L, …]; compiled to a loop (§4.3)
  use lnf    : norm.LayerNorm{D}
  param head : param ℝ[D, V]  init = zeros    -- projection onto the vocabulary (logits)

  -- The causal mask is derived from the type: position i only sees j ≤ i.
  -- This is the property that the inference kv_cache will exploit (§7).
  fn apply(ids : Tokens) -> ℝ[batch: B, seq: T, vocab: V] =
    let mask = causal_mask(seq: T)                  -- ℝ[seq, seq2], 0 where j≤i, else −∞
    let h0   = emb.apply(ids)
    let hL   = blocks.apply(h0, mask)               -- applies the L blocks in turn
    lnf.apply(hL) · head                            -- ℝ[batch, seq, vocab: V]
}
