-- mlp.psk — The smallest "complete" Presk program.
-- Illustrates: module, param + init, fn apply, composition, and typed grad.
-- No machine precision appears: everything is exact ℝ (cf. §2).

module Linear{In Out : dim} {
  param w : ℝ[In, Out]  init = xavier_uniform
  param b : ℝ[Out]      init = zeros

  fn apply(x : ℝ[..., In]) -> ℝ[..., Out] =
    x · w + b            -- "·": contraction over the last axis, broadcast of b
}

-- A two-layer perceptron. `hidden` is a symbolic dimension:
-- the same definition serves all sizes, checked at instantiation.
module MLP{D hidden : dim} {
  use l1 : Linear{D, hidden}
  use l2 : Linear{hidden, D}

  -- gelu is C∞; apply is therefore inferred C∞ (differentiable to any order).
  fn apply(x : ℝ[..., D]) -> ℝ[..., D] =
    l2.apply(gelu(l1.apply(x)))
}

-- Toy objective: mean squared error against a fixed target.
-- θ is the parameter pytree generated automatically from the module's `param`s.
fn mse{D : dim}(net : MLP{D, 4*D}, θ : params net, x : ℝ[batch: B, model: D],
                y : ℝ[batch: B, model: D]) -> ℝ[] =
  let ŷ = net.apply(θ, x)
  mean((ŷ - y)^2)

-- grad requires at least class C⁰⁺; mse is C∞ ⇒ accepted.
-- The derivative is taken with respect to the parameters only (x, y are captured).
fn mse_grad{D : dim}(net : MLP{D, 4*D}, θ : params net,
                     x : ℝ[batch: B, model: D], y : ℝ[batch: B, model: D])
    -> params net =
  grad(λ θ. mse(net, θ, x, y))(θ)
