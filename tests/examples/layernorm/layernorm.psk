-- layernorm.psk — Layer normalization.
-- Illustrates: reductions over a named axis, vector params (gain/bias),
-- and the principle "numerical stability belongs to the compiler, not to the code".

module LayerNorm{D : dim} {
  param γ : ℝ[D]  init = ones     -- gain
  param β : ℝ[D]  init = zeros    -- bias

  -- eps is NOT a numerical guard: the semantics is exact (division by the
  -- real standard deviation). It is a hyperparameter of the *model* (regularization), hence f64.
  -- The stability of sqrt and division is handled at compile time under the budget (§8.2),
  -- not here.
  fn apply(x : ℝ[..., model: D], eps : f64 = 1e-5) -> ℝ[..., model: D] =
    let μ  = mean(axis model, x)                 -- ℝ[...]
    let σ2 = mean(axis model, (x - μ)^2)         -- variance, reduction over `model`
    let x̂  = (x - μ) / sqrt(σ2 + real(eps))       -- real(eps): explicit f64 -> ℝ injection
    x̂ * γ + β                                     -- broadcast of γ, β over the leading axes
}

-- RMSNorm: variant without recentering, same reduction pattern.
module RMSNorm{D : dim} {
  param γ : ℝ[D]  init = ones

  fn apply(x : ℝ[..., model: D], eps : f64 = 1e-6) -> ℝ[..., model: D] =
    let ms = mean(axis model, x^2)
    x / sqrt(ms + real(eps)) * γ
}
