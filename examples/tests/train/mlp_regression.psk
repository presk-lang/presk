-- mlp_regression.psk — a linear regression trained by `presk train`:
-- y = 2·x₀ − x₁ + 0.5 on 256 samples (reg.psk.d, from reg.txt with
-- `presk data pack --type '(ℝ[2], ℝ[1])' reg.txt -o reg.psk.d`).
import "../../spec/mlp/mlp.psk" as ff
dim B

module Reg {
  use l : ff.Linear{2, 1}
  fn apply(x : ℝ[batch: B, 2]) -> ℝ[batch: B, 1] = l.apply(x)
}

fn loss(θ : params Reg, batch : (ℝ[batch: B, 2], ℝ[batch: B, 1])) -> ℝ[] =
  let (x, y) = batch
  mean((Reg.apply(θ, x) - y)^2)

optimizer adamw {
  lr : f64 = 0.05
}

training run {
  model     = Reg
  objective = loss
  optimizer = adamw
  data      = stream "reg.psk.d" |> shuffle(seed = 7) |> batch(B = 16)
  epochs    : nat = 20
}
