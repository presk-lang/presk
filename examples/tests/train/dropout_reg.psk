-- dropout_reg.psk — the regression of `mlp_regression.psk` with a hidden
-- layer and dropout, to exercise the per-step key of a training run
-- (0.4.0 step 3). The objective takes a key between `θ` and the batch; the
-- loop derives a fresh one from the run's seed at every step, and `dropout`
-- draws its mask from it.
import "../../spec/mlp/mlp.psk" as ff
dim B

module Reg {
  use l1 : ff.Linear{2, 8}
  use l2 : ff.Linear{8, 1}

  fn apply(x : ℝ[batch: B, 2], key : key) -> ℝ[batch: B, 1] uses Rand =
    let (k1, k2) = split_key(key)
    let h = dropout(0.1, k1, gelu(l1.apply(x)))
    dropout(0.1, k2, l2.apply(h))
}

fn loss(θ : params Reg, key : key, batch : (ℝ[batch: B, 2], ℝ[batch: B, 1])) -> ℝ[] uses Rand =
  let (x, y) = batch
  mean((Reg.apply(θ, x, key) - y)^2)

optimizer adamw {
  lr : f64 = 0.05
}

training run {
  model     = Reg
  objective = loss
  optimizer = adamw
  data      = stream "reg.psk.d" |> shuffle(seed = 7) |> batch(B = 16)
  epochs    : nat = 40
}
