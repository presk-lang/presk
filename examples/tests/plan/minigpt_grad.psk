-- The gradient of MiniGPT's training loss, an entry of `make plan-check`
-- (plan 0.9.0, step 0). It reaches the adjoints of attention (the softmax,
-- the scores and values `ein`s, `split_heads` and `merge_heads`) and of the
-- stacked blocks, which no other entry of `entries.txt` does: `mse_grad`
-- differentiates an MLP. The loss is `train_minigpt.psk`'s.
--
-- The model is MiniGPT's: its blocks and final norm are the example's
-- modules, its embeddings the example's `Embedding` written out (a tree
-- `params Model` does not bind the imported module's `T`), and its output
-- head is drawn instead of zero. The example's `head` is `init = zeros`, so on the
-- parameters `presk run` synthesizes every gradient but the head's would be
-- exactly zero, and the adjoint kernels would run on zeros.
import "../../spec/minigpt/minigpt.psk"    as m
import "../../spec/layernorm/layernorm.psk" as norm

dim B
dim T <= 1024

type Tokens = idx[m.V][batch: B, seq: T]

module Model {
  param tok  : ℝ[vocab: m.V, model: m.D]  init = normal(std = 0.02)
  param pos  : ℝ[T, m.D]                  init = normal(std = 0.02)
  use blocks : stack{m.L}(m.Block)
  use lnf    : norm.LayerNorm{m.D}
  param head : ℝ[m.D, m.V]                init = xavier_uniform

  fn apply(ids : Tokens) -> ℝ[batch: B, seq: T, vocab: m.V] =
    let mask = causal_mask(seq: T)
    let h0   = embed(tok, ids) + embed(pos, positions(seq: T))
    lnf.apply(blocks.apply(h0, mask)) · head
}

fn loss(θ : params Model, batch : (Tokens, Tokens)) -> ℝ[] =
  let (x, y) = batch
  mean(cross_entropy(Model.apply(θ, x), y))

fn loss_grad(θ : params Model, batch : (Tokens, Tokens)) -> params Model =
  grad(λ θ. loss(θ, batch))(θ)
