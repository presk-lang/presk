-- E7003: `embed`, `cross_entropy`, `argmax` and `sample` with no index
-- below `V` (`V = 0`). At `T = 0` the indices have no element, so the
-- entry's parameters have values; at `T ≥ 1` they have none (run_no_value).
--   presk run examples/tests/diag/run_vocab.psk --entry lookup --dim V=0 --dim T=0
--   presk run examples/tests/diag/run_vocab.psk --entry loss --dim V=0 --dim T=0
--   presk run examples/tests/diag/run_vocab.psk --entry pick --dim V=0 --dim T=3
--   presk run examples/tests/diag/run_vocab.psk --entry draw --dim V=0 --dim T=3
dim V
dim T

fn lookup(w : ℝ[V, 4], t : idx[V][seq: T]) -> ℝ[seq: T, 4] = embed(w, t)
fn loss(x : ℝ[seq: T, vocab: V], t : idx[V][seq: T]) -> ℝ[seq: T] = cross_entropy(x, t)
fn pick(x : ℝ[seq: T, vocab: V]) -> idx[V][seq: T] = argmax(x)
fn draw(key : key, x : ℝ[seq: T, vocab: V]) -> idx[V][seq: T] uses Rand = sample(key, x)
